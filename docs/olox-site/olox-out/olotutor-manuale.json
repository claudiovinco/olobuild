e-beb2-a89dd23b8321","type":"badge","settings":{"text":"§1","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"ee8af4b2-449d-4697-b547-63b404ac1081","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"a8d4e2a2-0576-4792-b9d9-197a3beb1047","type":"headline","settings":{"heading":"Cos’è OLOtutor","accent_text":"OLOtutor","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"e5e16477-faa4-45a5-8da6-6609a5f36f1a","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"d5504966-1466-4437-a155-5429595da7d6","type":"text-block","settings":{"content":"<p>OLOtutor è il modulo formazione della suite: un <strong>LMS dentro WordPress</strong> per scuole, accademie e formatori. Corsi, lezioni, quiz, punti, badge e certificati, pubblicati sul tuo dominio.</p><p>La differenza rispetto ai marketplace di corsi: <strong>gli allievi restano tuoi</strong>. Iscrizioni, dati e pagamenti passano dal tuo sito, non da una piattaforma che ti mette in fila coi concorrenti e trattiene una percentuale.</p><p><strong>Stato — </strong>Prodotto <strong>in sviluppo</strong>: questo manuale descrive le fondamenta su cui è costruito. Il telaio su cui poggerà, sito, prenotazioni, lingue, è già disponibile.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"b8103a7b-3201-49ef-a0b7-35a971897634","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"e68cc26c-cf35-45c1-a99b-4fe28fabb49a","type":"menuanchor","settings":{"anchor_id":"c2"},"style":[],"advanced":[]},{"id":"360e7cf7-0547-4123-97b4-b814b9fb2d9a","type":"badge","settings":{"text":"§2","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"d494587c-3d15-4f2a-981b-58fd6b6119cc","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"784aa0c3-4821-4e03-bb70-a28ff8ffc0f6","type":"headline","settings":{"heading":"Corsi & lezioni","accent_text":"lezioni","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"869d1830-fb35-430a-8496-36e624bade69","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"fe19ef0e-81d1-4875-a5e3-3cfea7902540","type":"text-block","settings":{"content":"<ul><li><strong>Struttura di corso</strong>: moduli e lezioni ordinate, con prerequisiti: la lezione 4 si apre dopo la 3.</li><li><strong>Contenuti misti</strong>: testo, video, materiali scaricabili, costruiti coi tile di OLObuild.</li><li><strong>Area allievi</strong>: ogni iscritto vede i propri corsi, i progressi e il punto in cui ha lasciato.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"27152446-9cd7-49ef-a7a4-e14778149fc2","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"2f1e0967-7e27-46bb-83a2-016a1813a40f","type":"menuanchor","settings":{"anchor_id":"c3"},"style":[],"advanced":[]},{"id":"faecfd71-372a-4677-b583-c3c053f45be6","type":"badge","settings":{"text":"§3","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"420985ed-b934-4886-8ccc-6b12724ff509","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"02145fd4-f673-402f-8c9f-d2a9a35e2c7d","type":"headline","settings":{"heading":"Quiz & gamification","accent_text":"gamification","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"28407b36-64a8-4ded-988f-afddb0e3dcbc","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"5b1e64bf-aa7c-4668-a621-9e09a0133946","type":"text-block","settings":{"content":"<ul><li><strong>Quiz</strong>: verifiche a risposta multipla con soglia di superamento e tentativi configurabili.</li><li><strong>Punti e badge</strong>: XP per lezioni e verifiche completate, badge ai traguardi.</li><li><strong>Mini-giochi</strong>: esercizi interattivi per tenere alta l’attenzione.</li></ul><p>La motivazione fa parte del metodo, non è un plugin in più.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"f0935322-3391-4454-8860-2714f11a08a3","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"7ac09a9d-8e89-45cd-a2fc-02fc97e850d5","type":"menuanchor","settings":{"anchor_id":"c4"},"style":[],"advanced":[]},{"id":"fa446ecd-7efd-4318-a39e-6475d78f79f3","type":"badge","settings":{"text":"§4","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"2b49935b-26ac-4357-9f2e-88a59e3c01da","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"bb97ba9f-bd7a-44b5-adec-238e662afe5d","type":"headline","settings":{"heading":"Registro & certificati","accent_text":"certificati","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"67dbc1f0-b0b6-4ff9-a4d1-0c79e230974c","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"fa4550c7-07ff-4c65-afe2-e4cfc916ad59","type":"text-block","settings":{"content":"<ul><li><strong>Registro voti</strong>: l’esito di ogni verifica, per allievo e per corso, consultabile dal docente.</li><li><strong>Certificati di completamento</strong>: generati al superamento del corso, pronti da scaricare.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"e520e96d-638a-4fa2-97bc-826348cb4b08","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"a1ec9a79-67b1-4430-b128-b30a57e6a012","type":"menuanchor","settings":{"anchor_id":"c5"},"style":[],"advanced":[]},{"id":"dbdceb17-912b-4606-bbbc-ac1eed1686ae","type":"badge","settings":{"text":"§5","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"780631c3-8ac5-4fa7-9637-92afdaa891a0","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"ded48b9f-6c26-4d47-9468-fa5dbe125a0f","type":"headline","settings":{"heading":"Nella suite","accent_text":"suite","accent_c