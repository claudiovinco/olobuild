ent_italic":true,"tag":"h1","alignment":"left","heading_size":"lg","heading_font_size":"56","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"5489eb26-a251-4b86-987b-620c7611622d","type":"spacer","settings":{"height":"12"},"style":[],"advanced":[]},{"id":"593876c8-15c5-43a1-ac1e-940f09027e69","type":"text-block","settings":{"content":"<p>Le fondamenta di OLOtutor: corsi, quiz, gamification, registro e certificati. Documento concettuale del prodotto in sviluppo.</p>","text_color":"#B9BDC9","font_size":"16","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]}]}]}]},{"id":"8da58c98-45ca-4ba2-b855-e57dc36a9d49","type":"section","settings":{"bg":{"type":"none"},"light_color":"#38C172","style":"default","width":"default","padding":"custom","padding_top_custom":20,"padding_bottom_custom":120,"bg_scope":"section","sticky_effect":"none"},"style":[],"advanced":[],"children":[{"id":"f0f85311-d64f-4291-a9a0-fcaa80a46b55","type":"row","settings":{"bg":{"type":"none"},"layout":"25-75","stack_mobile":true},"style":[],"advanced":[],"children":[{"id":"c2aea125-2ab3-45e7-86c5-76045173babf","type":"column","settings":{"bg":{"type":"none"},"width_medium":"1-4"},"style":[],"advanced":[],"children":[{"id":"dec5700b-6611-466c-89e0-1f5fc58b90a1","type":"toc","settings":{"title":"Sommario","max_depth":"2","list_style":"numbered","sticky":true,"highlight_active":true,"smooth_scroll":true,"typography_preset":"olox-mono","font_size":"12","text_color":"#8B90A0","link_color":"#B9BDC9","title_color":"#FAF7F2"},"style":[],"advanced":[]}]},{"id":"4af0c06a-8718-4b41-a0d4-093a6ca74bce","type":"column","settings":{"bg":{"type":"none"},"width_medium":"3-4"},"style":[],"advanced":[],"children":[{"id":"fd604be3-79bb-4e74-ace6-ead837341ef3","type":"menuanchor","settings":{"anchor_id":"c1"},"style":[],"advanced":[]},{"id":"d6d83ae1-f556-4ecc-9ebb-7e816940e0f9","type":"badge","settings":{"text":"§1","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"2a8cfe22-64ca-490c-ba38-a47964989f63","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"659525f0-f327-4f52-a5eb-d886338192cd","type":"headline","settings":{"heading":"Cos’è OLOtutor","accent_text":"OLOtutor","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"06bd49c5-8cf1-43b7-900f-252021f4c8f8","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"1eeb261e-0164-4fd2-aaf6-62c86947a9de","type":"text-block","settings":{"content":"<p>OLOtutor è il modulo formazione della suite: un <strong>LMS dentro WordPress</strong> per scuole, accademie e formatori. Corsi, lezioni, quiz, punti, badge e certificati, pubblicati sul tuo dominio.</p><p>La differenza rispetto ai marketplace di corsi: <strong>gli allievi restano tuoi</strong>. Iscrizioni, dati e pagamenti passano dal tuo sito, non da una piattaforma che ti mette in fila coi concorrenti e trattiene una percentuale.</p><p><strong>Stato — </strong>Prodotto <strong>in sviluppo</strong>: questo manuale descrive le fondamenta su cui è costruito. Il telaio su cui poggerà, sito, prenotazioni, lingue, è già disponibile.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"6f1f8bef-10a9-44c7-b818-c93fdabbeb99","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"8243e751-d0fa-49ca-8205-3217cb6f3038","type":"menuanchor","settings":{"anchor_id":"c2"},"style":[],"advanced":[]},{"id":"d08353ab-cc21-4343-a1f9-64b6059e43f2","type":"badge","settings":{"text":"§2","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"bcdb1339-9f85-4492-b1a5-746ac41f7d96","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"0693d9a9-eed6-41f3-8ea1-9285601df95d","type":"headline","settings":{"heading":"Corsi & lezioni","accent_text":"lezioni","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"f0a4876d-37fa-469d-ba4f-cf79b0028636","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"d7576877-5e38-4a74-8c68-e369b50753bc","type":"text-block","settings":{"content":"<ul><li><strong>Struttura di corso</strong>: moduli e lezioni ordinate, con prerequisiti: la lezione 4 si apre dopo la 3.</li><li><strong>Contenuti misti</strong>: testo, video, materiali scaricabili, costruiti coi tile di OLObuild.</li><li><strong>Area allievi</strong>: ogni iscritto vede i propri corsi, i progressi e il punto in cui ha lasciato.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"c5fb6ec2-8332-4e77-80ac-1f2b6092f3e4","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"54fbec86-2929-45ef-9c65-ee77ee9ab3a7","type":"menuanchor","settings":{"anchor_id":"c3"},"style":[],"advanced":[]},{"id":"59e74dc4-edd6-40b8-9195-edad28379bcd","type":"badge","settings":{"text":"§3","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"6e74913d-eeb2-4748-869e-0626a2abd56c","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"634e0834-3645-4358-a6e0-a93eaa7d3b30","type":"headline","settings":{"heading":"Quiz & gamification","accent_text":"gamification","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"27d3fade-f47a-4ba2-b601-9a932629f32b","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"20ae29a0-1177-4d62-b505-2a6b1926851d","type":"text-block","settings":{"content":"<ul><li><strong>Quiz</strong>: verifiche a risposta multipla con soglia di superamento e tentativi configurabili.</li><li><strong>Punti e badge</strong>: XP per lezioni e verifiche completate, badge ai traguardi.</li><li><strong>Mini-giochi</strong>: esercizi interattivi per tenere alta l’attenzione.</li></ul><p>La motivazione fa parte del metodo, non è un plugin in più.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"01f3a306-faec-4fa4-a22b-a02ff31fcbed","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"ae463eab-a672-4a67-999a-64dc04c7ef87","type":"menuanchor","settings":{"anchor_id":"c4"},"style":[],"advanced":[]},{"id":"7f158050-26f5-41ed-9346-a005f63dbbea","type":"badge","settings":{"text":"§4","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"34818527-4a5b-46cd-8178-d6a00fd79aeb","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"8ba0d71f-fd8e-4794-9436-7aa8857d061c","type":"headline","settings":{"heading":"Registro & certificati","accent_text":"certificati","accent_color":"#38C172","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"10222c14-9c27-418e-a22d-1f1543b71f7f","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"127dd1f9-d055-4459-80b9-92739836c876","type":"text-block","settings":{"content":"<ul><li><strong>Registro voti</strong>: l’esito di ogni verifica, per allievo e per corso, consultabile dal docente.</li><li><strong>Certificati di completamento</strong>: generati al superamento del corso, pronti da scaricare.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"d0591ac5-5c4d-4cd9-a133-c441340b59ef","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"b9c1e173-c1e2-4bf3-81dc-745a5c0d59a6","type":"menuanchor","settings":{"anchor_id":"c5"},"style":[],"advanced":[]},{"id":"bfc5f6e6-d05f-470c-9825-9ac22e7f0817","type":"badge","settings":{"text":"§5","variant":"outline","bg_color":"transparent","text_color":"#38C172","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"a89d7f63-154b-49de-9011-d3a66c186f8c","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"7558504b-836f-41bb-90ae-509a0ce05299","type":"headline","settings":{"heading":"Nella suite","accent_text":"suite","accent_c