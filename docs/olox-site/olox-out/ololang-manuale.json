1","alignment":"left","heading_size":"lg","heading_font_size":"56","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"404aec6d-d892-45d1-be18-3bcf708abcb6","type":"spacer","settings":{"height":"12"},"style":[],"advanced":[]},{"id":"d5f75256-5fd5-46dd-9e64-6346e9ae98ee","type":"text-block","settings":{"content":"<p>Come OLOlang traduce davvero un sito WordPress, dal database alla SEO, e come si lavora nella dashboard translator.</p>","text_color":"#B9BDC9","font_size":"16","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]}]}]}]},{"id":"edb0adf7-81cf-4311-8b3e-c4801e53730c","type":"section","settings":{"bg":{"type":"none"},"light_color":"#E8409A","style":"default","width":"default","padding":"custom","padding_top_custom":20,"padding_bottom_custom":120,"bg_scope":"section","sticky_effect":"none"},"style":[],"advanced":[],"children":[{"id":"c92c3b6b-cf45-418c-937b-e04e95c3d54f","type":"row","settings":{"bg":{"type":"none"},"layout":"25-75","stack_mobile":true},"style":[],"advanced":[],"children":[{"id":"a09f7b7e-51b5-49a4-9a78-bffa08b0de90","type":"column","settings":{"bg":{"type":"none"},"width_medium":"1-4"},"style":[],"advanced":[],"children":[{"id":"40ebfa11-5e84-46d3-86a1-0de4ffc045f6","type":"toc","settings":{"title":"Sommario","max_depth":"2","list_style":"numbered","sticky":true,"highlight_active":true,"smooth_scroll":true,"typography_preset":"olox-mono","font_size":"12","text_color":"#8B90A0","link_color":"#B9BDC9","title_color":"#FAF7F2"},"style":[],"advanced":[]}]},{"id":"26360df3-e0b5-4530-9483-d25eb4af9be5","type":"column","settings":{"bg":{"type":"none"},"width_medium":"3-4"},"style":[],"advanced":[],"children":[{"id":"2e51db23-ecc5-48e6-9ec6-8d2c6d4a2c0c","type":"menuanchor","settings":{"anchor_id":"c1"},"style":[],"advanced":[]},{"id":"f2716422-0aab-4a8d-b4aa-11f8f4677378","type":"badge","settings":{"text":"§1","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"f416ed96-4f00-4e88-888d-cb1d72f5897e","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"42ba986b-d84f-4b98-8de6-fda2043a28fb","type":"headline","settings":{"heading":"Cos’è OLOlang","accent_text":"OLOlang","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"79b5d037-6496-490e-8d39-a86016d0125a","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"00a9d011-7627-4ccf-a401-ef9acc468470","type":"text-block","settings":{"content":"<p>OLOlang è il sistema multilingua <strong>nativo</strong> della suite: porta un sito WordPress in <strong>28 lingue</strong> senza plugin terzi e senza patch fragili sul frontend. È incluso gratis il primo anno con OLObuild Free e <strong>a vita</strong> con OLObuild Pro.</p><p>“Nativo” significa che la traduzione non è uno strato appiccicato sopra: passa dal <strong>database</strong>, copre contenuti, menu e stringhe, e produce URL e metadati di prima classe per ogni lingua.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"d9d8d83d-8298-4ecb-99f8-22e28945c056","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"35736b50-be9a-4253-8591-1060d2a29826","type":"menuanchor","settings":{"anchor_id":"c2"},"style":[],"advanced":[]},{"id":"ef54f8bf-f8f5-441f-aa81-cc806873fb89","type":"badge","settings":{"text":"§2","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"5046326d-bfb4-4a92-87ed-18d5438f7fc4","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"89656684-59d2-4b2b-b88c-0fe89ba8f034","type":"headline","settings":{"heading":"Come traduce","accent_text":"traduce","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"4084df12-6bef-4578-9b37-013b40fa9d16","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"fbc7ddc5-044c-414b-8228-2ed7bef12e7f","type":"text-block","settings":{"content":"<ul><li><strong>Contenuti</strong>: pagine, articoli, tile OLObuild: ogni lingua ha la sua versione, salvata nel DB.</li><li><strong>Menu</strong>: le voci di navigazione seguono la lingua attiva, senza duplicare i menu a mano.</li><li><strong>Stringhe</strong>: testi di tema e plugin (bottoni, etichette, messaggi) tradotti via database.</li></ul><p><strong>Perché via DB — </strong>Le soluzioni che riscrivono l’HTML al volo si rompono a ogni cambio di tema. Le traduzioni nel database sopravvivono: sono contenuto, non trucco.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"7f3d0228-d0d9-4cb4-99eb-8b67e10b8372","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"3ee6d725-d5b6-4d59-a4ae-b5cf37cbe7b8","type":"menuanchor","settings":{"anchor_id":"c3"},"style":[],"advanced":[]},{"id":"1e4c7706-503d-48eb-ac2c-56de698bd7c6","type":"badge","settings":{"text":"§3","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"98f6d01f-d1ad-40aa-8094-828efed96ef2","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"b3056ada-2122-412e-b5a7-b8fda9ff34b4","type":"headline","settings":{"heading":"I motori","accent_text":"motori","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"c05820f4-1cfc-48d5-b66d-c92f7127ad9e","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"30226268-2854-4df8-a606-af2152e0abec","type":"text-block","settings":{"content":"<ul><li><strong>DeepL</strong>: traduzione automatica di qualità per le lingue coperte.</li><li><strong>Traduttore IA</strong>: per raffinare, adattare il tono, coprire le lingue restanti.</li><li><strong>Glossario</strong>: i tuoi termini (brand, prodotti, tecnicismi) restano tuoi in ogni lingua: “OLObuild” non diventa mai altro.</li><li><strong>Memoria di traduzione</strong>: una frase già tradotta si riusa: coerenza garantita e costi che scendono col tempo.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"fbac0cad-e395-4e09-912a-a049e94d99f7","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"f4bf6965-8486-4587-81e2-22a8ad2c3225","type":"menuanchor","settings":{"anchor_id":"c4"},"style":[],"advanced":[]},{"id":"28506f59-2727-4a97-baa2-263de9f7f9a0","type":"badge","settings":{"text":"§4","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"5fc86f28-04c9-4d4f-b306-6bfe4ab7f7e6","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"425b2dfa-81d5-4bc8-9aff-809271379072","type":"headline","settings":{"heading":"Il workflow","accent_text":"workflow","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"183900e4-d0fb-4350-83d2-5f41a66c0ee9","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"d98a9f77-6466-4d99-9fbf-dd292ce4466b","type":"text-block","settings":{"content":"<p>La <strong>dashboard translator</strong> è la vista di chi traduce: avanzamento per lingua, stringhe mancanti, coda di revisione. Il flusso tipico:</p><ul><li><strong>1 · Batch automatico</strong>: DeepL/IA traducono in blocco i contenuti nella lingua scelta.</li><li><strong>2 · Revisione umana</strong>: il translator scorre le voci, corregge, approva.</li><li><strong>3 · Pubblicazione</strong>: la lingua va online con URL, menu e SEO già a posto.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"ee3d0146-7264-477c-a7a8-7c8fe3a09978","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"d3cda09a-55bd-42ee-83ce-eb428c40bd39","type":"menuanchor","settings":{"anchor_id":"c5"},"style":[],"advanced":[]},{"id":"3239597e-57b1-4feb-8ee7-b84d662eed8c","type":"badge","settings":{"text":"§5","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"9667b916-b3b8-4444-bf4d-17f729b50bea","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"60dd7d85-847c-4b36-b40e-81197ad321a1","type":"headline","settings":{"heading":"SEO multilingua","accent_text":"multilingua","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"9bb5f0d6-b4a4-47de-af55-e4e2c201da96","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"f57f1e43-9b14-46d2-960b-2cf73a582704","type":"text-block","settings":{"content":"<ul><li><strong>hreflang</strong>: ogni pagina dichiara le sue varianti: Google indirizza l’utente alla lingua giusta.</li><li><strong>URL localizzati</strong>: <code>/it/camere-vista-lago</code>, <code>/en/lake-view-rooms</code>, <code>/de/zimmer-mit-seeblick</code>.</li><li><strong>Sitemap</strong>: tutte le varianti in sitemap, meta e title per lingua.</li></ul><p>Nessuna versione è figlia di un dio minore: per i motori di ricerca ogni lingua è una pagina di prima classe.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"0ad2340d-7f40-4036-a857-aa81862e158c","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"5d310093-c6e4-4f0f-958c-f4990ff36878","type":"menuanchor","settings":{"anchor_id":"spec"},"style":[],"advanced":[]},{"id":"11309b04-3864-4905-9c52-77990ea993de","type":"headline","settings":{"heading":"Scheda tecnica","accent_text":"tecnica","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"40","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"7dc10178-179f-4dfb-9764-076426e2daee","type":"spacer","settings":{"height":"10"},"style":[],"advanced":[]},{"id":"67e009b6-dff5-4e8b-a3b6-fec1be819cd7","type":"badge","settings":{"text":"OLOlang · multilingua · incluso con OLObuild","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"11","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"56c5f616-ab27-4add-989a-b77c31f1ba6e","type":"spacer","settings":{"height":"22"},"style":[],"advanced":[]},{"id":"7b5a0afe-2028-43c5-a3c4-984166ea20c0","type":"desclist","settings":{"items":[{"id":"sp-0","term":"Tipo","definition":"Sistema multilingua nativo per WordPress","icon":""},{"id":"sp-1","term":"Requisiti","definition":"WordPress 5.9+ · PHP 7.4+ · OLObuild","icon":""},{"id":"sp-2","term":"Lingue","definition":"28","icon":""},{"id":"sp-3","term":"Motori","definition":"DeepL + traduttore IA","icon":""},{"id":"sp-4","term":"Qualità","definition":"Glossario termini protetti · memoria di traduzione","icon":""},{"id":"sp-5","term":"Ambito","definition":"Contenuti, menu, stringhe di tema e plugin, via database","icon":""},{"id":"sp-6","term":"Workflow","definition":"Dashboard translator: batch automatico → revisione → pubblicazione","icon":""},{"id":"sp-7","term":"SEO","definition":"hreflang, URL localizzati, sitemap e meta per lingua","icon":""},{"id":"sp-8","term":"Suite","definition":"Traduce anche i flussi OLObooking e i tile OLObuild","icon":""},{"id":"sp-9","term":"Costo","definition":"Gratis il 1° anno (Free) · a vita con OLObuild Pro","icon":""}],"layout":"stacked","show_icon":false,"separator":true,"striped":false,"term_color":"#FAF7F2","term_font_size":"14","term_font_weight":"700","definition_color":"#B9BDC9","definition_font_size":"14","border_color":"rgba(250,247,242,.12)","spacing":"14","text_align":"left"},"style":[],"advanced":[]}]}]},{