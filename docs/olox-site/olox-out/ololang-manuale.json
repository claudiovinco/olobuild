1","alignment":"left","heading_size":"lg","heading_font_size":"56","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"fb0d9f9f-d7d2-4ad9-9bb3-e6d6e7df2920","type":"spacer","settings":{"height":"12"},"style":[],"advanced":[]},{"id":"88fe078c-0fee-4b0b-be5e-36e5ec3118ff","type":"text-block","settings":{"content":"<p>Come OLOlang traduce davvero un sito WordPress, dal database alla SEO, e come si lavora nella dashboard translator.</p>","text_color":"#B9BDC9","font_size":"16","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]}]}]}]},{"id":"aefee68c-39ad-44d1-8e2b-52eab65b85b2","type":"section","settings":{"bg":{"type":"none"},"light_color":"#E8409A","style":"default","width":"default","padding":"custom","padding_top_custom":20,"padding_bottom_custom":120,"bg_scope":"section","sticky_effect":"none"},"style":[],"advanced":[],"children":[{"id":"fc2b692c-6abd-4107-afd4-a08879ded265","type":"row","settings":{"bg":{"type":"none"},"layout":"25-75","stack_mobile":true},"style":[],"advanced":[],"children":[{"id":"c14ed02a-749f-4577-a3b8-4570aac488a3","type":"column","settings":{"bg":{"type":"none"},"width_medium":"1-4"},"style":[],"advanced":[],"children":[{"id":"005a72e8-6519-403c-a955-a79bba19c4e4","type":"toc","settings":{"title":"Sommario","max_depth":"2","list_style":"numbered","sticky":true,"highlight_active":true,"smooth_scroll":true,"typography_preset":"olox-mono","font_size":"12","text_color":"#8B90A0","link_color":"#B9BDC9","title_color":"#FAF7F2"},"style":[],"advanced":[]}]},{"id":"0dbced21-8968-4c14-a36a-7e88133f9d1e","type":"column","settings":{"bg":{"type":"none"},"width_medium":"3-4"},"style":[],"advanced":[],"children":[{"id":"9bbc4fde-9436-45cd-a2fb-399d6f665a20","type":"menuanchor","settings":{"anchor_id":"c1"},"style":[],"advanced":[]},{"id":"40802964-4b7c-4873-8c8a-68995b58055d","type":"badge","settings":{"text":"§1","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"25f8fc0f-3612-4084-9b81-07ee7ff9e69c","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"2b0609b5-16b7-49db-af85-fce7b515b7f0","type":"headline","settings":{"heading":"Cos’è OLOlang","accent_text":"OLOlang","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"0df6db71-3313-4bd6-9c72-bf687bd10bfe","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"573ed734-1c2c-4252-a2ef-884f504221fc","type":"text-block","settings":{"content":"<p>OLOlang è il sistema multilingua <strong>nativo</strong> della suite: porta un sito WordPress in <strong>28 lingue</strong> senza plugin terzi e senza patch fragili sul frontend. È incluso gratis il primo anno con OLObuild Free e <strong>a vita</strong> con OLObuild Pro.</p><p>“Nativo” significa che la traduzione non è uno strato appiccicato sopra: passa dal <strong>database</strong>, copre contenuti, menu e stringhe, e produce URL e metadati di prima classe per ogni lingua.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"20efa026-cd70-460f-b130-3754d6dd00c2","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"30a8d69c-1cb0-45fd-9044-acd1581f9587","type":"menuanchor","settings":{"anchor_id":"c2"},"style":[],"advanced":[]},{"id":"99cf9da5-529b-42a3-9e97-5dfaa75765a6","type":"badge","settings":{"text":"§2","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"2e2d8d80-fb0f-4b54-9e1e-2add6df42375","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"73686c52-c9ec-4dd7-b2ca-8468c3b428f1","type":"headline","settings":{"heading":"Come traduce","accent_text":"traduce","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"c6f19a7d-238c-4cc9-81b3-ae824619413f","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"5a4b1a4d-4073-45c8-820f-76ee37d9fd02","type":"text-block","settings":{"content":"<ul><li><strong>Contenuti</strong>: pagine, articoli, tile OLObuild: ogni lingua ha la sua versione, salvata nel DB.</li><li><strong>Menu</strong>: le voci di navigazione seguono la lingua attiva, senza duplicare i menu a mano.</li><li><strong>Stringhe</strong>: testi di tema e plugin (bottoni, etichette, messaggi) tradotti via database.</li></ul><p><strong>Perché via DB — </strong>Le soluzioni che riscrivono l’HTML al volo si rompono a ogni cambio di tema. Le traduzioni nel database sopravvivono: sono contenuto, non trucco.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"14eed9ea-cc1a-4450-a257-68aceca4a534","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"d182102d-568e-4f4f-918c-2d20f90e611b","type":"menuanchor","settings":{"anchor_id":"c3"},"style":[],"advanced":[]},{"id":"10d9fb11-ecf2-4a38-8b21-b40b4298b68f","type":"badge","settings":{"text":"§3","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"8f85c674-b52c-4f4b-bf67-ac38eed41938","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"98260276-97fd-4c43-afa2-167a068ec00d","type":"headline","settings":{"heading":"I motori","accent_text":"motori","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"42829c7a-861e-484c-920b-a7a1946966c1","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"9da56ccb-701e-429e-8532-0e1819e544cc","type":"text-block","settings":{"content":"<ul><li><strong>DeepL</strong>: traduzione automatica di qualità per le lingue coperte.</li><li><strong>Traduttore IA</strong>: per raffinare, adattare il tono, coprire le lingue restanti.</li><li><strong>Glossario</strong>: i tuoi termini (brand, prodotti, tecnicismi) restano tuoi in ogni lingua: “OLObuild” non diventa mai altro.</li><li><strong>Memoria di traduzione</strong>: una frase già tradotta si riusa: coerenza garantita e costi che scendono col tempo.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"5b8f1904-d450-4341-8d4a-ef3e849b40f8","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"fb913b3c-c677-49d3-a984-f441b068a70e","type":"menuanchor","settings":{"anchor_id":"c4"},"style":[],"advanced":[]},{"id":"44bcbf9e-7022-42da-98ac-dd7012bec17c","type":"badge","settings":{"text":"§4","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"c87e60d0-9f23-4ee1-bdef-e26a91dd6497","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"084a0981-f328-475b-8326-dcb6d1d4d2a8","type":"headline","settings":{"heading":"Il workflow","accent_text":"workflow","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"691650c4-7e5a-48e8-bd6c-93cb297080cb","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"7e17e2dd-3047-418f-9320-a0de58bd1f41","type":"text-block","settings":{"content":"<p>La <strong>dashboard translator</strong> è la vista di chi traduce: avanzamento per lingua, stringhe mancanti, coda di revisione. Il flusso tipico:</p><ul><li><strong>1 · Batch automatico</strong>: DeepL/IA traducono in blocco i contenuti nella lingua scelta.</li><li><strong>2 · Revisione umana</strong>: il translator scorre le voci, corregge, approva.</li><li><strong>3 · Pubblicazione</strong>: la lingua va online con URL, menu e SEO già a posto.</li></ul>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"f26aee6d-e92c-4abf-9ffb-edca0e41a770","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"ff95b84d-e4b4-4a64-a3f8-2dd9c2820f0c","type":"menuanchor","settings":{"anchor_id":"c5"},"style":[],"advanced":[]},{"id":"d4acc8c8-1f3f-4d04-ba0f-dda39334b5a8","type":"badge","settings":{"text":"§5","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"12","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"c967cbc2-9e3d-4d99-986e-9979be3b0f89","type":"spacer","settings":{"height":"8"},"style":[],"advanced":[]},{"id":"0ea9e49c-a290-42ca-862f-263a27dd3c1e","type":"headline","settings":{"heading":"SEO multilingua","accent_text":"multilingua","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"34","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"e8110f61-8a80-4ec8-885a-62be209b1189","type":"spacer","settings":{"height":"14"},"style":[],"advanced":[]},{"id":"9b660fba-1a77-4c22-a183-0a71f4469a07","type":"text-block","settings":{"content":"<ul><li><strong>hreflang</strong>: ogni pagina dichiara le sue varianti: Google indirizza l’utente alla lingua giusta.</li><li><strong>URL localizzati</strong>: <code>/it/camere-vista-lago</code>, <code>/en/lake-view-rooms</code>, <code>/de/zimmer-mit-seeblick</code>.</li><li><strong>Sitemap</strong>: tutte le varianti in sitemap, meta e title per lingua.</li></ul><p>Nessuna versione è figlia di un dio minore: per i motori di ricerca ogni lingua è una pagina di prima classe.</p>","text_color":"#B9BDC9","font_size":"15","text_align":"left","max_width":"560","tile_padding":{"top":0,"right":0,"bottom":0,"left":0}},"style":[],"advanced":[]},{"id":"a1157017-a3d2-42b3-a8b5-c6212e8a1604","type":"spacer","settings":{"height":"44"},"style":[],"advanced":[]},{"id":"8f651a1d-a2a3-4872-8cd0-e4afa664678f","type":"menuanchor","settings":{"anchor_id":"spec"},"style":[],"advanced":[]},{"id":"80a252af-a186-4062-b12b-614b1ab9b37e","type":"headline","settings":{"heading":"Scheda tecnica","accent_text":"tecnica","accent_color":"#E8409A","accent_italic":true,"tag":"h2","alignment":"left","heading_size":"lg","heading_font_size":"40","heading_font":"'Fraunces', serif","heading_weight":"400","heading_color":"#FAF7F2","decoration":"none","subtitle":""},"style":[],"advanced":[]},{"id":"aa850cb8-5b3f-47f2-ac8d-58ec920ac3bd","type":"spacer","settings":{"height":"10"},"style":[],"advanced":[]},{"id":"3abd35a0-c7cd-43be-a4ae-9404c5c2dc1b","type":"badge","settings":{"text":"OLOlang · multilingua · incluso con OLObuild","variant":"outline","bg_color":"transparent","text_color":"#E8409A","typography_preset":"olox-mono","font_size":"11","font_weight":"600","text_transform":"uppercase","letter_spacing":"2","padding_y":0,"padding_x":0,"alignment":"left"},"style":[],"advanced":[]},{"id":"78f280dc-8892-4c47-8141-557ac62a82a9","type":"spacer","settings":{"height":"22"},"style":[],"advanced":[]},{"id":"8a95b4a1-9de6-4447-94f6-4bdbd54c7e8b","type":"desclist","settings":{"items":[{"id":"sp-0","term":"Tipo","definition":"Sistema multilingua nativo per WordPress","icon":""},{"id":"sp-1","term":"Requisiti","definition":"WordPress 5.9+ · PHP 7.4+ · OLObuild","icon":""},{"id":"sp-2","term":"Lingue","definition":"28","icon":""},{"id":"sp-3","term":"Motori","definition":"DeepL + traduttore IA","icon":""},{"id":"sp-4","term":"Qualità","definition":"Glossario termini protetti · memoria di traduzione","icon":""},{"id":"sp-5","term":"Ambito","definition":"Contenuti, menu, stringhe di tema e plugin, via database","icon":""},{"id":"sp-6","term":"Workflow","definition":"Dashboard translator: batch automatico → revisione → pubblicazione","icon":""},{"id":"sp-7","term":"SEO","definition":"hreflang, URL localizzati, sitemap e meta per lingua","icon":""},{"id":"sp-8","term":"Suite","definition":"Traduce anche i flussi OLObooking e i tile OLObuild","icon":""},{"id":"sp-9","term":"Costo","definition":"Gratis il 1° anno (Free) · a vita con OLObuild Pro","icon":""}],"layout":"stacked","show_icon":false,"separator":true,"striped":false,"term_color":"#FAF7F2","term_font_size":"14","term_font_weight":"700","definition_color":"#B9BDC9","definition_font_size":"14","border_color":"rgba(250,247,242,.12)","spacing":"14","text_align":"left"},"style":[],"advanced":[]}]}]},{