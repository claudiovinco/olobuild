ex_wrap":"nowrap","flex_gap":"0"},"style":[],"advanced":[],"children":[{"id":"411262f7-df5d-47c2-99d7-a5e81aa16504","type":"column","settings":{"width_default":"","width_medium":"1-1"},"style":[],"advanced":[],"children":[{"id":"b2aa0e4a-ff30-4216-9e61-911975eb9142","type":"html","settings":{"html_content":"<section id=\"verticali\">\n    <header class=\"olo-section-head\">\n        <p class=\"olo-eyebrow\">I sei verticali</p>\n        <h2>Ognuno con la sua logica di dominio</h2>\n        <p class=\"olo-section-sub\">Non sei configurazioni dello stesso oggetto — sei verticali specializzati, costruiti sul medesimo telaio.</p>\n    </header>\n    <div class=\"olo-products-grid\">\n        <article class=\"olo-product\" data-color=\"#1E88E5\">\n            <h3>Accommodation</h3>\n            <p class=\"olo-tagline\">Hotel, B&amp;B, case vacanza</p>\n            <p>iCal bidirezionale Airbnb/Booking/VRBO, tariffe stagionali, check-in/out, CIN, 13 tile dedicati.</p>\n            <p><a class=\"olo-cta\" href=\"https://olotheme.com/prodotti/olobooking/accommodation/\">Approfondisci →</a></p>\n        </article>\n        <article class=\"olo-product\" data-color=\"#1E88E5\">\n            <h3>Appointments</h3>\n            <p class=\"olo-tagline\">Professionisti, cliniche, servizi</p>\n            <p>Slot generator parametrico, buffer/blackout, operatori multipli, reminder SMS+email T-24h/T-1h.</p>\n            <p><a class=\"olo-cta\" href=\"https://olotheme.com/prodotti/olobooking/appointments/\">Approfondisci →</a></p>\n        </article>\n        <article class=\"olo-product\" data-color=\"#1E88E5\">\n            <h3>Events</h3>\n            <p class=\"olo-tagline\">Organizzatori eventi</p>\n            <p>Biglietti con capacità e waitlist, PDF A6 con QR, check-in PWA, roster A4 stampabile.</p>\n            <p><a class=\"olo-cta\" href=\"https://olotheme.com/prodotti/olobooking/events/\">Approfondisci →</a></p>\n        </article>\n        <article class=\"olo-product\" data-color=\"#1E88E5\">\n            <h3>Real-estate</h3>\n            <p class=\"olo-tagline\">Agenzie immobiliari</p>\n            <p>Lead scoring 0-100, kanban pipeline, ricerche salvate + alert, preferiti cliente, booking visite.</p>\n            <p><a class=\"olo-cta\" href=\"https://olotheme.com/prodotti/olobooking/real-estate/\">Approfondisci →</a></p>\n        </article>\n        <article class=\"olo-product\" data-color=\"#1E88E5\">\n            <h3>Rentals</h3>\n            <p class=\"olo-tagline\">Noleggi veicoli e attrezzature</p>\n            <p>Tariffe stagionali, one-way parametrico, registri veicoli, ispezioni pre/post, contratto PDF.</p>\n            <p><a class=\"olo-cta\" href=\"https://olotheme.com/prodotti/olobooking/rentals/\">Approfondisci →</a></p>\n        </article>\n        <article class=\"olo-product\" data-color=\"#1E88E5\">\n            <h3>Restaurants</h3>\n            <p class=\"olo-tagline\">Ristoranti</p>\n            <p>Floor plan editor drag &amp; drop, allocatore best-fit tavoli, sale multiple, recensioni, reminder SMS.</p>\n            <p><a class=\"olo-cta\" href=\"https://olotheme.com/prodotti/olobooking/restaurants/\">Approfondisci →</a></p>\n        </article>\n    </div>\n</section>"},"style":[],"advanced":[]}]}]}]},{"id":"145cef26-6338-4399-bc78-0db5b8020daf","type":"section","settings":{"style":"default","width":"default","padding":"default","flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0","layout_mode":"flex","sticky_effect":"none","scroll_snap":false},"style":[],"advanced":[],"children":[{"id":"4c3743c1-3aca-4eb7-8b43-2c32b84fad9a","type":"row","settings":{"layout":"100","gap":0,"column_gap":"default","vertical_align":"top","stack_mobile":true,"flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0"},"style":[],"advanced":[],"children":[{"id":"ec3c8bee-be36-427b-be56-ce4b455d3a62","type":"column","settings":{"width_default":"","width_medium":"1-1"},"style":[],"advanced":[],"children":[{"id":"a79d1def-311f-4bcc-818a-5191bc452e68","type":"html","settings":{"html_content":"<section>\n    <header class=\"olo-section-head\">\n        <p class=\"olo-eyebrow\">Quello che condividono</p>\n        <h2>Un core, nove componenti, sei verticali</h2>\n        <p class=\"olo-section-sub\">Quando aggiungi un secondo verticale (es. da Hotel a Ristorante annesso), lo configuri — non lo reinstalli da zero.</p>\n    </header>\n    <ul class=\"olo-features\">\n        <li><strong>Map + Calendar core</strong> — 4 componenti base, 13 wrapper specializzati. Calendari sincronizzati tra verticali.</li>\n        <li><strong>Payment tracking</strong> — Stripe + bonifico + acconti. Multi-currency, no fee per transazione (paghi solo Stripe).</li>\n        <li><strong>Multilingua via OLOlang</strong> — manager e frontend tradotti, descriptor verticali in IT/EN/DE.</li>\n        <li><strong>Email branded</strong> — template configurabili, dominio sender personalizzato, niente \"via mailgun.com\" nei messaggi.</li>\n        <li><strong>Licensing Ed25519</strong> — server-side, no API call obbligatorie al runtime. Funziona offline.</li>\n        <li><strong>REST API custom</strong> — namespace dedicato, ogni endpoint documentato, integrabile con qualunque CRM/PMS esterno.</li>\n        <li><strong>Setup wizard a 5 step</strong> — configurazione iniziale in mezz'ora.</li>\n        <li><strong>Integrazione OLObuild</strong> — tile + shortcode per ogni verticale, design coerente col tuo sito.</li>\n        <li><strong>Bundle features atomici</strong> — JS + CSS sempre allineati, niente \"ho aggiornato e si è rotto qualcosa\".</li>\n    </ul>\n</section>"},"style":[],"advanced":[]}]}]}]},{"id":"10c52d76-4859-4045-9b85-c33ddd61ec72","type":"section","settings":{"style":"default","width":"default","padding":"default","flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap