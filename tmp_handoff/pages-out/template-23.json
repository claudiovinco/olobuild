f3-961e-4985903c3f48","type":"html","settings":{"html_content":"<section>\n    <header class=\"olo-section-head\">\n        <p class=\"olo-eyebrow\">Cosa puoi fare</p>\n        <h2>Otto cose che Matterport non ti lascia fare</h2>\n    </header>\n    <ul class=\"olo-features\">\n        <li><strong>Panorami e video 360°</strong> — equirectangolari, qualità nativa. Carichi le tue foto da qualunque camera (Insta360, Ricoh Theta, anche smartphone), niente hardware proprietario.</li>\n        <li><strong>9 tipi di hotspot</strong> — navigazione, info, link esterno, video, gallery, <strong>prodotto WooCommerce</strong> (unico!), form contatto, audio, embed HTML.</li>\n        <li><strong>VR stereo + giroscopo mobile</strong> — visore Cardboard, orientamento smartphone, fullscreen one-tap. Esperienza immersiva senza app.</li>\n        <li><strong>Varianti scena</strong> — la stessa stanza in versione giorno/notte, vuota/arredata, prima/dopo restauro. Switch a runtime.</li>\n        <li><strong>Pianta interattiva</strong> — planimetria con punti scene cliccabili, navigazione spaziale fluida.</li>\n        <li><strong>Blur zone privacy</strong> — anonimizzazione automatica di visi e targhe (GDPR-friendly).</li>\n        <li><strong>Integrazione OLObuild</strong> — tile dedicato + shortcode, embed in qualunque pagina del sito.</li>\n        <li><strong>Multilingua via OLOlang</strong> — hotspot, etichette e info traducibili in 28 lingue.</li>\n    </ul>\n</section>"},"style":[],"advanced":[]}]}]}]},{"id":"969f40fe-77d1-4035-b301-e962748a1193","type":"section","settings":{"style":"default","width":"default","padding":"default","flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0","layout_mode":"flex","sticky_effect":"none","scroll_snap":false},"style":[],"advanced":[],"children":[{"id":"8609ac35-a26d-4d2e-b523-31b994c8e7e1","type":"row","settings":{"layout":"100","gap":0,"column_gap":"default","vertical_align":"top","stack_mobile":true,"flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0"},"style":[],"advanced":[],"children":[{"id":"5526e833-4fa7-457f-898f-c58ee739944c","type":"column","settings":{"width_default":"","width_medium":"1-1"},"style":[],"advanced":[],"children":[{"id":"49cd7dc8-2bf1-4e9e-9c6f-76d4d6b8c0c8","type":"html","settings":{"html_content":"<section class=\"olo-compare\">\n    <header class=\"olo-section-head\">\n        <p class=\"olo-eyebrow\">vs altre soluzioni 360°</p>\n        <h2>Perché aspettare OLOtour</h2>\n    </header>\n    <div class=\"olo-compare-wrapper\">\n    <table class=\"olo-compare-table\">\n        <thead>\n            <tr>\n                <th></th>\n                <th class=\"olo-compare-us\">OLOtour</th>\n                <th>Matterport</th>\n                <th>Kuula</th>\n                <th>3DVista</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr><td>Hardware-agnostic (qualunque camera 360)</td><td class=\"olo-compare-us\">✓</td><td>✗ hardware proprietario</td><td>✓</td><td>✓</td></tr>\n            <tr><td>Hotspot prodotto WooCommerce</td><td class=\"olo-compare-us\">✓ unico</td><td>✗</td><td>✗</td><td>✗</td></tr>\n            <tr><td>Integrato in WordPress nativo</td><td class=\"olo-compare-us\">✓ tile OLObuild</td><td>solo embed iframe</td><td>solo embed iframe</td><td>export HTML/iframe</td></tr>\n            <tr><td>Self-hosted (file sul tuo server)</td><td class=\"olo-compare-us\">✓ sempre</td><td>✗ cloud only</td><td>✗ cloud only</td><td>✓ con $499 license</td></tr>\n            <tr><td>Multilingua nativo</td><td class=\"olo-compare-us\">✓ via OLOlang</td><td>parziale</td><td>parziale</td><td>parziale</td></tr>\n            <tr><td>Prezzo annuale</td><td class=\"olo-compare-us\">in roadmap · annuncio al lancio</td><td>$69-309/mese</td><td>$16-32/mese</td><td>$499 one-time</td></tr>\n        </tbody>\n    </table>\n    </div>\n</section>"},"style":[],"advanced":[]}]}]}]},{"id":"5d72852b-a7d4-4018-84f8-a30160a64a60","type":"section","settings":{"style":"default","width":"default","padding":"default","flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0","layout_mode":"flex","sticky_effect":"none","scroll_snap":false},"style":[],"advanced":[],"children":[{"id":"ff8750d0-58f1-4ed2-ac2e-cc9607a6e176","type":"row","settings":{"layout":"100","gap":0,"column_gap":"default","vertical_align":"top","stack_mobile":true,"flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0"},"style":[],"advanced":[],"children":[{"id":"f44f7d6c-280d-466c-b131-55e6310ac6b6","type":"column","settings":{"width_default":"","width_medium":"1-1"},"style":[],"advanced":[],"children":[{"id":"bdcf2e37-15ae-4353-a8d7-cdf870692441","type":"html","settings":{"html_content":"<section class=\"olo-use-cases-section\">\n    <header class=\"olo-section-head\">\n        <p class=\"olo-eyebrow\">Per chi</p>\n        <h2>Casi d'uso reali</h2>\n    </header>\n    <div class=\"olo-use-case-grid\">\n        <article>\n            <div class=\"olo-uc-icon\">🏨</div>\n            <h3>Hotel e strutture ricettive</h3>\n            <p>Tour camere e spazi comuni con hotspot \"Prenota questa camera\" diretto al booking engine (OLObooking Accommodation). Conversione +15% media stimata vs sito senza tour.</p>\n        </article>\n        <article>\n            <div class=\"olo-uc-icon\">🏘</div>\n            <h3>Agenzie immobiliari</h3>\n            <p>Visite virtuali integrate alla scheda annuncio, hotspot \"Prenota visita\" che parte da OLObooking Real-estate. Filtri lead non interessati prima della visita fisica.</p>\n        </article>\n        <article>\n            <div class=\"olo-uc-icon\">🏛</div>\n            <h3>Musei, showroom, fiere</h3>\n            <p>Percorsi guidati con hotspot audio narrazione, video approfondimento, embed prodotti shop museum. Accessibile sempre, da qualunque dispositivo.</p>\n        </article>\n        <article>\n            <div class=\"olo-uc-icon\">🏭</div>\n            <h3>Industry, facility management</h3>\n            <p>Documentazione impianti, training operatori, check pre-intervento. Self-hosted = niente dati sensibili sul cloud di terzi.</p>\n        </article>\n    </div>\n</section>"},"style":[],"advanced":[]}]}]}]},{"id":"6bc31dac-a771-46d4-8a9e-0e549ea87072","type":"section","settings":{"style":"default","width":"default","padding":"default","flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0","layout_mode":"flex","sticky_effect":"none","scroll_snap":false},"style":[],"advanced":[],"children":[{"id":"a545c525-abb2-465b-8241-6cdcce6d6242","type":"row","settings":{"layout":"100","gap":0,"column_gap":"default","vertical_align":"top","stack_mobile":true,"flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0"},"style":[],"advanced":[],"children":[{"id":"fedae6f4-5738-4b06-b6b3-b8ca55155e79","type":"column","settings":{"width_default":"","width_medium":"1-1"},"style":[],"advanced":[],"children":[{"id":"1ecffbaf-2d54-4c2c-a727-77fd8cac7168","type":"html","settings":{"html_content":"<section class=\"olo-faq\">\n    <header class=\"olo-section-head\">\n        <p class=\"olo-eyebrow\">FAQ OLOtour</p>\n        <h2>Le domande che ci fanno spesso</h2>\n    </header>\n    <div class=\"olo-faq-list\">\n        <details>\n            <summary>Quando esce OLOtour?</summary>\n            <p>Beta privata Q3 2026 (luglio-settembre). Rilascio pubblico previsto Q4 2026. Iscriviti per ricevere l'invito alla beta + sconto early-bird al lancio.</p>\n        </details>\n        <details>\n            <summary>Serve hardware specifico per fare i panorami?</summary>\n            <p>No. OLOtour è hardware-agnostic: qualunque foto/video 360° equirectangolare funziona. Camere consigliate: Insta360 ONE X3 (€ 450), Ricoh Theta Z1 (€ 1.000), o anche un buon smartphone con app 360 (€ 0).</p>\n        </details>\n        <details>\n            <summary>I tour si vedono su mobile e VR?</summary>\n            <p>Sì. Player web responsive, fullscreen one-tap su mobile, supporto giroscopo per esperienza \"guarda intorno\" senza touch, modalità VR stereo con visore Cardboard (€ 10).</p>\n        </details>\n        <details>\n            <summary>Posso vendere prodotti dentro il tour?</summary>\n            <p>Sì — è il nostro hotspot UNICO. Inserisci un hotspot \"prodotto WooCommerce\" su qualunque oggetto del tour: il visitatore clicca, vede scheda prodotto + carrello senza uscire dal tour. Conversion booster reale.</p>\n        </details>\n        <details>\n            <summary>I file dei tour dove restano?</summary>\n            <p>Sul tuo WordPress (cartella uploads, come per le immagini). Niente CDN proprietario, niente lock-in, niente \"il tuo tour è online finché paghi\". Self-hosted al 100%.</p>\n        </details>\n        <details>\n            <summary>Quanto pesa un tour medio?</summary>\n            <p>Panorama 8K equirectangolare: 8-12 MB. Tour 10 scene: ~100 MB totali. Con un hosting decente carichi in pochi secondi. Compressione automatica al caricamento.</p>\n        </details>\n    </div>\n</section>"},"style":[],"advanced":[]}]}]}]},{"id":"57167c0a-bc97-4cde-a3d5-5ad284501381","type":"section","settings":{"style":"default","width":"default","padding":"default","flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0","layout_mode":"flex","sticky_effect":"none","scroll_snap":false},"style":[],"advanced":[],"children":[{"id":"541e8611-dee9-43fb-8645-d6159c6ec6cc","type":"row","settings":{"layout":"100","gap":0,"column_gap":"default","vertical_align":"top","stack_mobile":true,"flex_direction":"row","flex_justify":"flex-start","flex_align":"stretch","flex_wrap":"nowrap","flex_gap":"0"},"style":[],"adva