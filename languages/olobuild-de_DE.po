msgid "Performance"
msgstr "Performance"

msgid "Critical CSS"
msgstr "Critical CSS"

msgid "Asset Optimizer"
msgstr "Asset-Optimierer"

msgid "Performance Hints"
msgstr "Performance-Hinweise"

msgid "Head Cleanup"
msgstr "Head-Bereinigung"

msgid "Attivo"
msgstr "Aktiv"

msgid "Off"
msgstr "Aus"

msgid "Rigenerazione in corso..."
msgstr "Wird regeneriert..."

msgid "Svuotare tutta la cache Critical CSS?"
msgstr "Den gesamten Critical-CSS-Cache leeren?"

msgid "Svuotare la cache CSS? I file verranno rigenerati automaticamente."
msgstr "CSS-Cache leeren? Die Dateien werden automatisch neu erzeugt."

msgid "Rigenerato %d su %d pagine (%d errori)"
msgstr "%d von %d Seiten regeneriert (%d Fehler)"

msgid "Svuotati %d transient Critical CSS"
msgstr "%d Critical-CSS-Transients gelöscht"

msgid "Cache CSS svuotata. I file verranno rigenerati al prossimo caricamento."
msgstr "CSS-Cache geleert. Die Dateien werden beim nächsten Laden neu erzeugt."

msgid "Salva impostazioni"
msgstr "Einstellungen speichern"

msgid "Genera automaticamente il CSS above-the-fold e lo inietta inline nel <head>. Il foglio di stile principale viene caricato in modo asincrono."
msgstr "Erzeugt automatisch das Above-the-Fold-CSS und fügt es inline im <head> ein. Das Haupt-Stylesheet wird asynchron geladen."

msgid "Abilita Critical CSS"
msgstr "Critical CSS aktivieren"

msgid "Migliora FCP e LCP inlinando il CSS critico e deferendo il resto."
msgstr "Verbessert FCP und LCP, indem das kritische CSS inline eingebettet und der Rest verzögert geladen wird."

msgid "Durata cache"
msgstr "Cache-Dauer"

msgid "Il CSS critico viene rigenerato automaticamente alla scadenza. Invalidato quando salvi un template."
msgstr "Das kritische CSS wird beim Ablauf automatisch neu erzeugt. Wird beim Speichern eines Templates invalidiert."

msgid "giorni"
msgstr "Tage"

msgid "Sezioni above-the-fold"
msgstr "Above-the-Fold-Sektionen"

msgid "Quante sezioni del template analizzare per il CSS critico. 2 è il valore consigliato."
msgstr "Wie viele Template-Sektionen für das kritische CSS analysiert werden sollen. 2 ist der empfohlene Wert."

msgid "Stato cache"
msgstr "Cache-Status"

msgid "Stato"
msgstr "Status"

msgid "Pagine in cache"
msgstr "Im Cache befindliche Seiten"

msgid "Mai"
msgstr "Nie"

msgid "Ultima generazione"
msgstr "Zuletzt generiert"

msgid "Rigenera tutto"
msgstr "Alles regenerieren"

msgid "Svuota cache"
msgstr "Cache leeren"

msgid "Ottimizzazione Asset"
msgstr "Asset-Optimierung"

msgid "Controlla come vengono caricati JavaScript e CSS nel frontend."
msgstr "Steuert, wie JavaScript und CSS im Frontend geladen werden."

msgid "Defer JavaScript"
msgstr "JavaScript zurückstellen"

msgid "Aggiunge l'attributo defer agli script frontend di Olobuild. Non blocca il rendering della pagina."
msgstr "Fügt das defer-Attribut zu den Frontend-Skripten von Olobuild hinzu. Das Rendering der Seite wird nicht blockiert."

msgid "Cache CSS su file"
msgstr "Datei-basierter CSS-Cache"

msgid "Salva il CSS generato dai template come file statici invece di iniettarlo inline. Migliora il caching del browser."
msgstr "Speichert das von Templates erzeugte CSS als statische Dateien, statt es inline einzubetten. Verbessert das Browser-Caching."

msgid "Minifica CSS"
msgstr "CSS minifizieren"

msgid "Rimuove commenti, spazi e newline dal CSS generato."
msgstr "Entfernt Kommentare, Leerzeichen und Zeilenumbrüche aus dem erzeugten CSS."

msgid "Cache CSS"
msgstr "CSS-Cache"

msgid "File in cache"
msgstr "Gecachte Dateien"

msgid "Dimensione totale"
msgstr "Gesamtgröße"

msgid "Svuota cache CSS"
msgstr "CSS-Cache leeren"

msgid "Resource Hints"
msgstr "Resource Hints"

msgid "Suggerimenti al browser per precaricare risorse e velocizzare il caricamento."
msgstr "Hinweise an den Browser zum Vorladen von Ressourcen, um die Ladezeit zu verkürzen."

msgid "DNS Prefetch & Preconnect"
msgstr "DNS Prefetch & Preconnect"

msgid "Aggiunge dns-prefetch e preconnect per Google Fonts, YouTube, Vimeo e altri domini esterni."
msgstr "Fügt dns-prefetch und preconnect für Google Fonts, YouTube, Vimeo und andere externe Domains hinzu."

msgid "Preload font"
msgstr "Schriftarten vorladen"

msgid "Precarica i font custom usati come body/heading per evitare FOUT (Flash of Unstyled Text)."
msgstr "Lädt benutzerdefinierte Schriftarten, die als body/heading verwendet werden, vor, um FOUT (Flash of Unstyled Text) zu vermeiden."

msgid "Video facade"
msgstr "Video-Facade"

msgid "Mostra un'anteprima statica dei video YouTube/Vimeo. L'iframe si carica solo al click. Risparmia ~500KB per video."
msgstr "Zeigt eine statische Vorschau für YouTube-/Vimeo-Videos. Der iframe wird erst beim Klick geladen. Spart ca. 500 KB pro Video."

msgid "fetchpriority hero image"
msgstr "fetchpriority Hero-Image"

msgid "Aggiunge fetchpriority=\"high\" alla prima immagine della pagina e rimuove lazy loading dagli elementi above-fold."
msgstr "Fügt fetchpriority=\"high\" zum ersten Bild der Seite hinzu und entfernt das Lazy Loading bei Above-the-Fold-Elementen."

msgid "Lazy loading immagini"
msgstr "Bilder per Lazy Loading laden"

msgid "Aggiunge loading=\"lazy\" alle immagini below-the-fold. Riduce il peso iniziale della pagina."
msgstr "Fügt loading=\"lazy\" zu Below-the-Fold-Bildern hinzu. Reduziert das anfängliche Seitengewicht."

msgid "Domini personalizzati"
msgstr "Benutzerdefinierte Domains"

msgid "Aggiungi domini per dns-prefetch e preconnect personalizzati (uno per riga, con https://)."
msgstr "Eigene Domains für dns-prefetch und preconnect hinzufügen (eine pro Zeile, mit https://)."

msgid "DNS Prefetch"
msgstr "DNS Prefetch"

msgid "Risolve il DNS in anticipo. Utile per CDN e servizi esterni."
msgstr "Löst DNS im Voraus auf. Nützlich für CDNs und externe Dienste."

msgid "Preconnect"
msgstr "Preconnect"

msgid "Apre connessione completa (DNS + TCP + TLS). Più aggressivo del dns-prefetch, usare solo per risorse critiche."
msgstr "Öffnet eine vollständige Verbindung (DNS + TCP + TLS). Aggressiver als dns-prefetch — nur für kritische Ressourcen verwenden."

msgid "Pulizia head"
msgstr "Head-Bereinigung"

msgid "Rimuovi risorse non necessarie dal <head> per ridurre richieste e peso della pagina."
msgstr "Entferne unnötige Ressourcen aus dem <head>, um Requests und Seitengewicht zu reduzieren."

msgid "Rimuovi jQuery Migrate"
msgstr "jQuery Migrate entfernen"

msgid "Rimuove jquery-migrate.js (~10KB). Necessario solo per compatibilità con plugin molto vecchi."
msgstr "Entfernt jquery-migrate.js (~10 KB). Nur für die Kompatibilität mit sehr alten Plugins erforderlich."

msgid "Rimuovi emoji scripts"
msgstr "Emoji-Skripte entfernen"

msgid "Rimuove wp-emoji-release.min.js e relativi stili inline. I browser moderni supportano emoji nativamente."
msgstr "Entfernt wp-emoji-release.min.js und die zugehörigen Inline-Stile. Moderne Browser unterstützen Emojis nativ."

msgid "Rimuovi Block CSS"
msgstr "Block-CSS entfernen"

msgid "Rimuove wp-block-library-css (~30KB). Attiva solo se non usi blocchi Gutenberg nel frontend."
msgstr "Entfernt wp-block-library-css (~30 KB). Nur aktivieren, wenn du keine Gutenberg-Blöcke im Frontend verwendest."

msgid "Rimuovi Classic Theme CSS"
msgstr "Classic-Theme-CSS entfernen"

msgid "Rimuove classic-theme-styles-css. Inutile se non usi un tema classico."
msgstr "Entfernt classic-theme-styles-css. Überflüssig, wenn du kein klassisches Theme verwendest."

msgid "Analytics"
msgstr "Analytics"

msgid "Provider"
msgstr "Anbieter"

msgid "Eventi"
msgstr "Ereignisse"

msgid "Impostazioni"
msgstr "Einstellungen"

msgid "Script personalizzati"
msgstr "Benutzerdefinierte Skripte"

msgid "Measurement ID di GA4. Lo trovi in Amministrazione &rarr; Flussi di dati."
msgstr "GA4-Measurement-ID. Zu finden unter Verwaltung &rarr; Datenströme."

msgid "Container ID di GTM. Se usi GTM per gestire GA4, non inserire anche il Measurement ID sopra."
msgstr "GTM-Container-ID. Wenn du GTM zur Verwaltung von GA4 verwendest, gib nicht zusätzlich die Measurement-ID oben ein."

msgid "Pixel ID di Meta/Facebook. Lo trovi in Events Manager &rarr; Impostazioni."
msgstr "Meta/Facebook-Pixel-ID. Zu finden im Events Manager &rarr; Einstellungen."

msgid "Project ID di Clarity. Heatmap e session recording gratuiti."
msgstr "Clarity-Projekt-ID. Kostenlose Heatmaps und Session-Recording."

msgid "Site ID di Hotjar. Lo trovi in Settings &rarr; Sites & Organizations."
msgstr "Hotjar-Site-ID. Zu finden unter Settings &rarr; Sites & Organizations."

msgid "Click sui pulsanti"
msgstr "Button-Klicks"

msgid "Invio form"
msgstr "Formular-Absenden"

msgid "Riproduzione video"
msgstr "Video-Wiedergabe"

msgid "Profondità di scroll"
msgstr "Scroll-Tiefe"

msgid "Click su pricing CTA"
msgstr "Klicks auf Pricing-CTA"

msgid "Download file"
msgstr "Datei-Download"

msgid "Link esterni"
msgstr "Externe Links"

msgid "Richiedi consenso cookie"
msgstr "Cookie-Zustimmung erforderlich"

msgid "Blocca gli script di tracking finché l'utente non accetta i cookie analitici/marketing dal banner Cookie Consent. Richiesto per GDPR."
msgstr "Blockiert Tracking-Skripte, bis der Nutzer die Analyse-/Marketing-Cookies im Cookie-Consent-Banner akzeptiert. Erforderlich für die DSGVO."

msgid "Anonimizza IP"
msgstr "IP anonymisieren"

msgid "GA4 anonimizza l'IP di default, ma questa opzione aggiunge il parametro esplicito per conformità."
msgstr "GA4 anonymisiert IP-Adressen standardmäßig, aber diese Option fügt zur Konformität den expliziten Parameter hinzu."

msgid "Rispetta Do Not Track"
msgstr "Do Not Track respektieren"

msgid "Non caricare gli script se il browser invia l'header Do Not Track."
msgstr "Tracking-Skripte nicht laden, wenn der Browser den Do-Not-Track-Header sendet."

msgid "Escludi amministratori"
msgstr "Administratoren ausschließen"

msgid "Non tracciare le visite degli utenti con ruolo Amministratore."
msgstr "Besuche von Nutzern mit der Rolle Administrator nicht tracken."

msgid "Non configurato"
msgstr "Nicht konfiguriert"

msgid "ID"
msgstr "ID"

msgid "Auto-tracking eventi"
msgstr "Automatisches Event-Tracking"

msgid "Scegli quali eventi tracciare automaticamente. Vengono inviati a tutti i provider configurati."
msgstr "Wähle aus, welche Ereignisse automatisch getrackt werden sollen. Sie werden an alle konfigurierten Anbieter gesendet."

msgid "Parametri eventi"
msgstr "Event-Parameter"

msgid "Configura i dettagli degli eventi di scroll e download."
msgstr "Konfiguriere die Details der Scroll- und Download-Ereignisse."

msgid "Milestone scroll (%)"
msgstr "Scroll-Meilensteine (%)"

msgid "Percentuali di scroll a cui inviare un evento (separate da virgola)."
msgstr "Scroll-Prozentsätze, bei denen ein Event gesendet wird (kommagetrennt)."

msgid "Estensioni download"
msgstr "Download-Erweiterungen"

msgid "Estensioni file da tracciare come download (separate da virgola)."
msgstr "Dateiendungen, die als Downloads getrackt werden (kommagetrennt)."

msgid "Privacy e conformità"
msgstr "Datenschutz und Compliance"

msgid "Opzioni di privacy, GDPR e gestione del consenso."
msgstr "Optionen für Datenschutz, DSGVO und Einwilligungsverwaltung."

msgid "Inserisci script di tracking aggiuntivi. Verranno bloccati dal consenso cookie se abilitato."
msgstr "Zusätzliche Tracking-Skripte einfügen. Sie werden vom Cookie-Consent blockiert, falls aktiviert."

msgid "Script nel <head>"
msgstr "Skripte im <head>"

msgid "Inseriti prima della chiusura di </head>. Utile per snippet di tracking non supportati nativamente."
msgstr "Werden vor dem schließenden </head> eingefügt. Nützlich für Tracking-Snippets, die nicht nativ unterstützt werden."

msgid "Script nel <body>"
msgstr "Skripte im <body>"

msgid "Inseriti prima della chiusura di </body>."
msgstr "Werden vor dem schließenden </body> eingefügt."

msgid "Vai al contenuto principale"
msgstr "Zum Hauptinhalt springen"

msgid "Riproduci video"
msgstr "Video abspielen"

msgid "Redirect & 404"
msgstr "Weiterleitung & 404"

msgid "Cookie Consent"
msgstr "Cookie-Zustimmung"

msgid "Generale"
msgstr "Allgemein"

msgid "Testi"
msgstr "Texte"

