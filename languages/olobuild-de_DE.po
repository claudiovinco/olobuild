msgstr "Cookie-Erklärung"

msgid "Log Consensi"
msgstr "Einwilligungsprotokoll"

msgid "%d consensi registrati. Il GDPR richiede di poter dimostrare il consenso raccolto."
msgstr "%d Einwilligungen erfasst. Die DSGVO verlangt, dass die erteilte Einwilligung nachgewiesen werden kann."

msgid "Svuotare tutti i log dei consensi?"
msgstr "Alle Einwilligungsprotokolle leeren?"

msgid "Questo contenuto richiede il consenso ai cookie"
msgstr "Dieser Inhalt erfordert die Cookie-Zustimmung"

msgid "Accetta e carica"
msgstr "Akzeptieren und laden"

msgid "Gestisci cookie"
msgstr "Cookies verwalten"

