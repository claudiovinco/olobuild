msgstr "Ikon színe"

msgid "A contorno"
msgstr "Körvonalas"

msgid "Scritta sottolineata"
msgstr "Aláhúzott felirat"

msgid "Linee e colore"
msgstr "Vonalak és szín"

msgid "Linea sopra il piede"
msgstr "Vonal a lábléc fölött"

msgid "Una linea sottile sopra il piede della card (le parti messe «Nel piede»)."
msgstr "Vékony vonal a kártya lábléce fölött (a „A láblécben” elhelyezett részek)."

msgid "Linea sotto ogni card"
msgstr "Vonal minden kártya alatt"

msgid "Barretta nel colore della voce"
msgstr "Sáv az elem színében"

msgid "Una barretta in fondo alla foto, nel colore scelto per ogni voce."
msgstr "Egy sáv a fotó alján, az egyes elemekhez választott színben."

