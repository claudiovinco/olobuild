msgid "Sfondo della scelta"
msgstr "Fond de la sélection"

#: src/config/elements/configuratore.js
msgid "Il fondo dell'opzione scelta. Vuoto: il colore della scelta, appena velato."
msgstr "Le fond de l’option choisie. Vide : la couleur de la sélection, à peine voilée."

