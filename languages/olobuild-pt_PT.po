msgstr "Cor do texto"

msgid "Colori pulsanti"
msgstr "Cores dos botões"

msgid "Personalizza i colori dei pulsanti \"Accetta\" e \"Rifiuta\""
msgstr "Personalize as cores dos botões \"Aceitar\" e \"Rejeitar\""

msgid "Pulsante primario — sfondo"
msgstr "Botão primário — fundo"

msgid "Pulsante primario — testo"
msgstr "Botão primário — texto"

msgid "Pulsante secondario — sfondo"
msgstr "Botão secundário — fundo"

msgid "Pulsante secondario — testo"
msgstr "Botão secundário — texto"

msgid "Stile"
msgstr "Estilo"

msgid "Overlay e border radius del banner"
msgstr "Overlay e border radius do banner"

msgid "Overlay scuro"
msgstr "Overlay escuro"

msgid "Oscura la pagina dietro il banner per attirare l'attenzione."
msgstr "Escurece a página atrás do banner para chamar atenção."

msgid "Border radius"
msgstr "Border radius"

msgid "Categorie cookie"
msgstr "Categorias de cookies"

msgid ""
"Personalizza nome e descrizione di ogni categoria mostrata nel pannello "
"preferenze."
msgstr ""
"Personalize o nome e a descrição de cada categoria exibida no painel de "
"preferências."

msgid "Sempre attivo"
msgstr "Sempre ativo"

msgid "Etichetta"
msgstr "Rótulo"

msgid "Descrizione"
msgstr "Descrição"

msgid "Blocco automatico script"
msgstr "Bloqueio automático de scripts"

msgid ""
"Blocca automaticamente script di terze parti finché l'utente non accetta la "
"categoria corrispondente."
msgstr ""
"Bloqueia automaticamente scripts de terceiros até que o usuário aceite a "
"categoria correspondente."

msgid "Abilita auto-blocco"
msgstr "Ativar bloqueio automático"

msgid ""
"Converte gli script corrispondenti in type=\"text/plain\" finché il consenso"
" non è dato."
msgstr ""
"Converte os scripts correspondentes para type=\"text/plain\" até que o "
"consentimento seja dado."

msgid "Pattern da bloccare"
msgstr "Padrões a bloquear"

msgid ""
"Un dominio/pattern per riga. Gli script il cui src contiene uno di questi "
"pattern vengono bloccati."
msgstr ""
"Um domínio/padrão por linha. Os scripts cujo src contém um desses padrões "
"são bloqueados."

msgid "Blocco manuale"
msgstr "Bloqueio manual"

msgid "Puoi anche bloccare script manualmente nel tuo HTML aggiungendo:"
msgstr ""
"Você também pode bloquear scripts manualmente no seu HTML adicionando:"

msgid "Dichiarazione cookie"
msgstr "Declaração de cookies"

msgid ""
"Elenca i cookie utilizzati dal sito. Questi vengono mostrati nel pannello "
"preferenze."
msgstr ""
"Liste os cookies usados pelo site. Eles são exibidos no painel de "
"preferências."

