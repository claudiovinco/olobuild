msgstr "ポリシーへのリンク"

msgid "URL e testi dei link alle pagine di policy"
msgstr "ポリシーページへの URL とリンクテキスト"

msgid "URL Privacy Policy"
msgstr "プライバシーポリシーの URL"

msgid "Testo link Privacy"
msgstr "プライバシーリンクのテキスト"

msgid "URL Cookie Policy"
msgstr "Cookie ポリシーの URL"

msgid "Testo link Cookie Policy"
msgstr "Cookie ポリシーリンクのテキスト"

msgid "Colori banner"
msgstr "バナーの色"

msgid "Sfondo e testo del cookie banner"
msgstr "Cookie バナーの背景とテキスト"

msgid "Sfondo banner"
msgstr "バナーの背景"

msgid "Colore testo"
msgstr "テキストの色"

msgid "Colori pulsanti"
msgstr "ボタンの色"

msgid "Personalizza i colori dei pulsanti \"Accetta\" e \"Rifiuta\""
msgstr "「同意」と「拒否」ボタンの色をカスタマイズ"

msgid "Pulsante primario — sfondo"
msgstr "プライマリボタン — 背景"

msgid "Pulsante primario — testo"
msgstr "プライマリボタン — テキスト"

msgid "Pulsante secondario — sfondo"
msgstr "セカンダリボタン — 背景"

msgid "Pulsante secondario — testo"
msgstr "セカンダリボタン — テキスト"

msgid "Stile"
msgstr "スタイル"

msgid "Overlay e border radius del banner"
msgstr "バナーのオーバーレイと border radius"

msgid "Overlay scuro"
msgstr "ダークオーバーレイ"

msgid "Oscura la pagina dietro il banner per attirare l'attenzione."
msgstr "バナーの背後のページを暗くして注意を引きます。"

msgid "Border radius"
msgstr "Border radius"

msgid "Categorie cookie"
msgstr "Cookie カテゴリ"

msgid "Personalizza nome e descrizione di ogni categoria mostrata nel pannello preferenze."
msgstr "環境設定パネルに表示される各カテゴリの名前と説明をカスタマイズします。"

msgid "Sempre attivo"
msgstr "常時有効"

msgid "Etichetta"
msgstr "ラベル"

msgid "Descrizione"
msgstr "説明"

msgid "Blocco automatico script"
msgstr "スクリプトの自動ブロック"

msgid "Blocca automaticamente script di terze parti finché l'utente non accetta la categoria corrispondente."
msgstr "ユーザが該当するカテゴリに同意するまで、サードパーティスクリプトを自動的にブロックします。"

msgid "Abilita auto-blocco"
msgstr "自動ブロックを有効化"

msgid "Converte gli script corrispondenti in type=\"text/plain\" finché il consenso non è dato."
msgstr "同意が得られるまで、一致するスクリプトを type=\"text/plain\" に変換します。"

msgid "Pattern da bloccare"
msgstr "ブロックするパターン"

msgid "Un dominio/pattern per riga. Gli script il cui src contiene uno di questi pattern vengono bloccati."
msgstr "1行に1つのドメイン/パターン。src にいずれかのパターンを含むスクリプトはブロックされます。"

msgid "Blocco manuale"
msgstr "手動ブロック"

msgid "Puoi anche bloccare script manualmente nel tuo HTML aggiungendo:"
msgstr "次の記述を追加することで、HTML 内でスクリプトを手動でブロックすることもできます:"

msgid "Dichiarazione cookie"
msgstr "Cookie の告知"

msgid "Elenca i cookie utilizzati dal sito. Questi vengono mostrati nel pannello preferenze."
msgstr "サイトで使用される Cookie を一覧表示します。これらは環境設定パネルに表示されます。"

