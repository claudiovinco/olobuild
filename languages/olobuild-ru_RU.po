msgid "Resource Hints"
msgstr "Resource Hints"

msgid "Suggerimenti al browser per precaricare risorse e velocizzare il caricamento."
msgstr "Подсказки браузеру для preload."

msgid "DNS Prefetch & Preconnect"
msgstr "DNS Prefetch & Preconnect"

msgid "Aggiunge dns-prefetch e preconnect per Google Fonts, YouTube, Vimeo e altri domini esterni."
msgstr "Добавляет dns-prefetch и preconnect."

msgid "Preload font"
msgstr "Preload шрифтов"

msgid "Precarica i font custom usati come body/heading per evitare FOUT (Flash of Unstyled Text)."
msgstr "Preload кастомных шрифтов."

msgid "Video facade"
msgstr "Видео facade"

msgid "Mostra un'anteprima statica dei video YouTube/Vimeo. L'iframe si carica solo al click. Risparmia ~500KB per video."
msgstr "Статич. превью YouTube/Vimeo."

msgid "fetchpriority hero image"
msgstr "fetchpriority hero image"

msgid "Aggiunge fetchpriority=\"high\" alla prima immagine della pagina e rimuove lazy loading dagli elementi above-fold."
msgstr "Добавляет fetchpriority=\"high\" к hero."

msgid "Lazy loading immagini"
msgstr "Lazy-загрузка изображений"

msgid "Aggiunge loading=\"lazy\" alle immagini below-the-fold. Riduce il peso iniziale della pagina."
msgstr "Добавляет loading=\"lazy\" к изображениям."

msgid "Domini personalizzati"
msgstr "Свои домены"

msgid "Aggiungi domini per dns-prefetch e preconnect personalizzati (uno per riga, con https://)."
msgstr "Добавьте домены для dns-prefetch."

msgid "DNS Prefetch"
msgstr "DNS Prefetch"

msgid "Risolve il DNS in anticipo. Utile per CDN e servizi esterni."
msgstr "Заранее разрешает DNS."

msgid "Preconnect"
msgstr "Preconnect"

msgid "Apre connessione completa (DNS + TCP + TLS). Più aggressivo del dns-prefetch, usare solo per risorse critiche."
msgstr "Открывает полное соединение."

msgid "Pulizia head"
msgstr "Очистка head"

msgid "Rimuovi risorse non necessarie dal <head> per ridurre richieste e peso della pagina."
msgstr "Удаляет ненужное из head."

msgid "Rimuovi jQuery Migrate"
msgstr "Удалить jQuery Migrate"

msgid "Rimuove jquery-migrate.js (~10KB). Necessario solo per compatibilità con plugin molto vecchi."
msgstr "Удаляет jquery-migrate.js (~10КБ)."

msgid "Rimuovi emoji scripts"
msgstr "Удалить emoji-скрипты"

msgid "Rimuove wp-emoji-release.min.js e relativi stili inline. I browser moderni supportano emoji nativamente."
msgstr "Удаляет wp-emoji-release.min.js."

msgid "Rimuovi Block CSS"
msgstr "Удалить Block CSS"

msgid "Rimuove wp-block-library-css (~30KB). Attiva solo se non usi blocchi Gutenberg nel frontend."
msgstr "Удаляет wp-block-library-css."

msgid "Rimuovi Classic Theme CSS"
msgstr "Удалить Classic Theme CSS"

msgid "Rimuove classic-theme-styles-css. Inutile se non usi un tema classico."
msgstr "Удаляет classic-theme-styles-css."

