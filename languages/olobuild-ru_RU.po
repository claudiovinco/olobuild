"     * @param string $active  Slug del tab attivo.\n"
"     *\n"
"     * @example\n"
"     *   echo Olo_Builder::cockpit_subnav([\n"
"     *     ['slug' => 'general', 'label' => 'Generale', 'href' => admin_url('admin.php?page=olo-seo')],\n"
