msgid "Rimuovi Classic Theme CSS"
msgstr "Supprimer le CSS Classic Theme"

#: includes/class-performance-settings.php:624
msgid "Rimuove classic-theme-styles-css. Inutile se non usi un tema classico."
msgstr ""
"Supprime classic-theme-styles-css. Inutile si vous n'utilisez pas un thème "
"classique."

