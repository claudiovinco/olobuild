msgid ""
"Scegli quali eventi tracciare automaticamente. Vengono inviati a tutti i "
"provider configurati."
msgstr ""
"Wybierz, ktore zdarzenia sledzic automatycznie. Sa wysylane do wszystkich "
"skonfigurowanych dostawcow."

#: includes/class-analytics-tracking.php:334
msgid "Parametri eventi"
msgstr "Parametry zdarzen"

#: includes/class-analytics-tracking.php:335
msgid "Configura i dettagli degli eventi di scroll e download."
msgstr "Skonfiguruj szczegoly zdarzen przewijania i pobierania."

#: includes/class-analytics-tracking.php:341
msgid "Milestone scroll (%)"
msgstr "Kamienie milowe przewijania (%)"

#: includes/class-analytics-tracking.php:342
msgid "Percentuali di scroll a cui inviare un evento (separate da virgola)."
msgstr ""
"Procenty przewijania, przy ktorych wyslac zdarzenie (oddzielone przecinkiem)."

