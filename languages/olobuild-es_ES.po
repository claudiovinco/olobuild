msgstr "Símbolo — tamaño"

msgid "Simbolo — spessore linea"
msgstr "Símbolo — grosor de línea"

msgid "Per le icone disegnate a linea: sottile accanto a un logo leggero, spessa accanto a uno pieno."
msgstr "Para los iconos de línea: fino junto a un logo ligero, grueso junto a uno en negrita."

msgid "Simbolo — sfondo"
msgstr "Símbolo — fondo"

msgid "Vuoto = il simbolo da solo. Con un colore il simbolo sta in un cerchio o in un riquadro."
msgstr "Vacío = solo el símbolo. Con un color, el símbolo va dentro de un círculo o un cuadrado."

