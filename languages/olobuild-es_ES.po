msgstr "El color del slot extendido sobre la imagen de fondo: cuanto más alto, más legible el texto."

msgid "Colore pastiglia"
msgstr "Color de la muestra"

msgid "Colori da provare"
msgstr "Colores para probar"

msgid "Bosco"
msgstr "Bosque"

msgid "Laguna"
msgstr "Laguna"

