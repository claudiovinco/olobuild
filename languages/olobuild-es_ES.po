msgstr "Scripts personalizados"

msgid "Measurement ID di GA4. Lo trovi in Amministrazione &rarr; Flussi di dati."
msgstr "Measurement ID de GA4. Lo encuentras en Administrar &rarr; Flujos de datos."

msgid "Container ID di GTM. Se usi GTM per gestire GA4, non inserire anche il Measurement ID sopra."
msgstr "Container ID de GTM. Si usas GTM para gestionar GA4, no introduzcas además el Measurement ID anterior."

msgid "Pixel ID di Meta/Facebook. Lo trovi in Events Manager &rarr; Impostazioni."
msgstr "Pixel ID de Meta/Facebook. Lo encuentras en Events Manager &rarr; Configuración."

msgid "Project ID di Clarity. Heatmap e session recording gratuiti."
msgstr "Project ID de Clarity. Mapas de calor y grabación de sesiones gratuitos."

msgid "Site ID di Hotjar. Lo trovi in Settings &rarr; Sites & Organizations."
msgstr "Site ID de Hotjar. Lo encuentras en Settings &rarr; Sites & Organizations."

