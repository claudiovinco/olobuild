msgid "Performance"
msgstr "Rendimiento"

msgid "Critical CSS"
msgstr "CSS crítico"

msgid "Asset Optimizer"
msgstr "Optimizador de recursos"

msgid "Performance Hints"
msgstr "Sugerencias de rendimiento"

msgid "Head Cleanup"
msgstr "Limpieza del head"

msgid "Attivo"
msgstr "Activo"

msgid "Off"
msgstr "Desactivado"

msgid "Rigenerazione in corso..."
msgstr "Regenerando..."

msgid "Svuotare tutta la cache Critical CSS?"
msgstr "¿Vaciar toda la caché de Critical CSS?"

msgid "Svuotare la cache CSS? I file verranno rigenerati automaticamente."
msgstr "¿Vaciar la caché de CSS? Los archivos se regenerarán automáticamente."

msgid "Rigenerato %d su %d pagine (%d errori)"
msgstr "Regeneradas %d de %d páginas (%d errores)"

msgid "Svuotati %d transient Critical CSS"
msgstr "Vaciados %d transients de Critical CSS"

msgid "Cache CSS svuotata. I file verranno rigenerati al prossimo caricamento."
msgstr "Caché de CSS vaciada. Los archivos se regenerarán en la próxima carga."

msgid "Salva impostazioni"
msgstr "Guardar configuración"

msgid "Genera automaticamente il CSS above-the-fold e lo inietta inline nel <head>. Il foglio di stile principale viene caricato in modo asincrono."
msgstr "Genera automáticamente el CSS above-the-fold y lo inyecta inline en el <head>. La hoja de estilos principal se carga de forma asíncrona."

msgid "Abilita Critical CSS"
msgstr "Activar Critical CSS"

msgid "Migliora FCP e LCP inlinando il CSS critico e deferendo il resto."
msgstr "Mejora FCP y LCP inlinando el CSS crítico y aplazando el resto."

msgid "Durata cache"
msgstr "Duración de la caché"

msgid "Il CSS critico viene rigenerato automaticamente alla scadenza. Invalidato quando salvi un template."
msgstr "El CSS crítico se regenera automáticamente al expirar. Se invalida al guardar una plantilla."

msgid "giorni"
msgstr "días"

msgid "Sezioni above-the-fold"
msgstr "Secciones above-the-fold"

msgid "Quante sezioni del template analizzare per il CSS critico. 2 è il valore consigliato."
msgstr "Cuántas secciones de la plantilla analizar para el CSS crítico. 2 es el valor recomendado."

msgid "Stato cache"
msgstr "Estado de la caché"

msgid "Stato"
msgstr "Estado"

msgid "Pagine in cache"
msgstr "Páginas en caché"

msgid "Mai"
msgstr "Nunca"

msgid "Ultima generazione"
msgstr "Última generación"

msgid "Rigenera tutto"
msgstr "Regenerar todo"

msgid "Svuota cache"
msgstr "Vaciar caché"

msgid "Ottimizzazione Asset"
msgstr "Optimización de recursos"

msgid "Controlla come vengono caricati JavaScript e CSS nel frontend."
msgstr "Controla cómo se cargan JavaScript y CSS en el frontend."

msgid "Defer JavaScript"
msgstr "Diferir JavaScript"

msgid "Aggiunge l'attributo defer agli script frontend di Olobuild. Non blocca il rendering della pagina."
msgstr "Añade el atributo defer a los scripts frontend de Olobuild. No bloquea la renderización de la página."

msgid "Cache CSS su file"
msgstr "Caché de CSS en archivo"

msgid "Salva il CSS generato dai template come file statici invece di iniettarlo inline. Migliora il caching del browser."
msgstr "Guarda el CSS generado por las plantillas como archivos estáticos en lugar de inyectarlo inline. Mejora el cacheo del navegador."

msgid "Minifica CSS"
msgstr "Minificar CSS"

msgid "Rimuove commenti, spazi e newline dal CSS generato."
msgstr "Elimina comentarios, espacios y saltos de línea del CSS generado."

msgid "Cache CSS"
msgstr "Caché de CSS"

msgid "File in cache"
msgstr "Archivos en caché"

msgid "Dimensione totale"
msgstr "Tamaño total"

msgid "Svuota cache CSS"
msgstr "Vaciar caché de CSS"

msgid "Resource Hints"
msgstr "Resource Hints"

msgid "Suggerimenti al browser per precaricare risorse e velocizzare il caricamento."
msgstr "Sugerencias al navegador para precargar recursos y acelerar la carga."

msgid "DNS Prefetch & Preconnect"
msgstr "DNS Prefetch y Preconnect"

msgid "Aggiunge dns-prefetch e preconnect per Google Fonts, YouTube, Vimeo e altri domini esterni."
msgstr "Añade dns-prefetch y preconnect para Google Fonts, YouTube, Vimeo y otros dominios externos."

msgid "Preload font"
msgstr "Precargar fuentes"

msgid "Precarica i font custom usati come body/heading per evitare FOUT (Flash of Unstyled Text)."
msgstr "Precarga las fuentes custom usadas como body/heading para evitar FOUT (Flash of Unstyled Text)."

msgid "Video facade"
msgstr "Fachada de video"

msgid "Mostra un'anteprima statica dei video YouTube/Vimeo. L'iframe si carica solo al click. Risparmia ~500KB per video."
msgstr "Muestra una vista previa estática de los vídeos de YouTube/Vimeo. El iframe se carga solo al hacer clic. Ahorra ~500 KB por vídeo."

msgid "fetchpriority hero image"
msgstr "fetchpriority hero image"

msgid "Aggiunge fetchpriority=\"high\" alla prima immagine della pagina e rimuove lazy loading dagli elementi above-fold."
msgstr "Añade fetchpriority=\"high\" a la primera imagen de la página y elimina el lazy loading de los elementos above-the-fold."

msgid "Lazy loading immagini"
msgstr "Lazy loading de imágenes"

msgid "Aggiunge loading=\"lazy\" alle immagini below-the-fold. Riduce il peso iniziale della pagina."
msgstr "Añade loading=\"lazy\" a las imágenes below-the-fold. Reduce el peso inicial de la página."

msgid "Domini personalizzati"
msgstr "Dominios personalizados"

msgid "Aggiungi domini per dns-prefetch e preconnect personalizzati (uno per riga, con https://)."
msgstr "Añade dominios personalizados para dns-prefetch y preconnect (uno por línea, con https://)."

msgid "DNS Prefetch"
msgstr "DNS Prefetch"

msgid "Risolve il DNS in anticipo. Utile per CDN e servizi esterni."
msgstr "Resuelve el DNS por adelantado. Útil para CDN y servicios externos."

msgid "Preconnect"
msgstr "Preconnect"

msgid "Apre connessione completa (DNS + TCP + TLS). Più aggressivo del dns-prefetch, usare solo per risorse critiche."
msgstr "Abre una conexión completa (DNS + TCP + TLS). Más agresivo que dns-prefetch: usar solo para recursos críticos."

msgid "Pulizia head"
msgstr "Limpieza del head"

msgid "Rimuovi risorse non necessarie dal <head> per ridurre richieste e peso della pagina."
msgstr "Elimina recursos innecesarios del <head> para reducir las peticiones y el peso de la página."

msgid "Rimuovi jQuery Migrate"
msgstr "Eliminar jQuery Migrate"

msgid "Rimuove jquery-migrate.js (~10KB). Necessario solo per compatibilità con plugin molto vecchi."
msgstr "Elimina jquery-migrate.js (~10 KB). Solo es necesario para la compatibilidad con plugins muy antiguos."

msgid "Rimuovi emoji scripts"
msgstr "Eliminar scripts de emoji"

msgid "Rimuove wp-emoji-release.min.js e relativi stili inline. I browser moderni supportano emoji nativamente."
msgstr "Elimina wp-emoji-release.min.js y sus estilos inline. Los navegadores modernos soportan emojis de forma nativa."

msgid "Rimuovi Block CSS"
msgstr "Eliminar CSS de bloques"

msgid "Rimuove wp-block-library-css (~30KB). Attiva solo se non usi blocchi Gutenberg nel frontend."
msgstr "Elimina wp-block-library-css (~30 KB). Actívalo solo si no usas bloques Gutenberg en el frontend."

msgid "Rimuovi Classic Theme CSS"
msgstr "Eliminar CSS de tema clásico"

msgid "Rimuove classic-theme-styles-css. Inutile se non usi un tema classico."
msgstr "Elimina classic-theme-styles-css. Inútil si no usas un tema clásico."

msgid "Analytics"
msgstr "Analytics"

