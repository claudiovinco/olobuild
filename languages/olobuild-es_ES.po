msgstr "Requerido por las directrices del CNIL y de la Autoridad italiana de Protección de Datos."

msgid "Mostra \"Personalizza\""
msgstr "Mostrar \"Personalizar\""

msgid "Pulsante per aprire il pannello preferenze con le categorie."
msgstr "Botón para abrir el panel de preferencias con las categorías."

msgid "Durata consenso"
msgstr "Duración del consentimiento"

msgid "GDPR raccomanda max 6 mesi (180 giorni). Molti usano 365."
msgstr "El RGPD recomienda un máximo de 6 meses (180 días). Muchos usan 365."

msgid "Richiedere nuovamente dopo"
msgstr "Volver a solicitar después de"

msgid "Se la cookie policy cambia, puoi forzare la ripresentazione del banner."
msgstr "Si cambia la política de cookies, puedes forzar que el banner se muestre de nuevo."

msgid "giorni (0 = mai)"
msgstr "días (0 = nunca)"

msgid "Google Consent Mode v2"
msgstr "Google Consent Mode v2"

msgid "Invia segnali gtag(\"consent\") a Google. Richiesto da Google Ads dal marzo 2024 per EEA/UK."
msgstr "Envía señales gtag(\"consent\") a Google. Requerido por Google Ads desde marzo de 2024 para EEE/Reino Unido."

msgid "Blocco iframe"
msgstr "Bloqueo de iframes"

msgid "Blocca iframe di YouTube, Vimeo, Google Maps fino al consenso. Mostra un placeholder con pulsante \"Carica contenuto\"."
msgstr "Bloquea iframes de YouTube, Vimeo y Google Maps hasta el consentimiento. Muestra un placeholder con el botón \"Cargar contenido\"."

msgid "Versione banner"
msgstr "Versión del banner"

msgid "Incrementa quando cambi la cookie policy. I visitatori con consenso a una versione precedente vedranno di nuovo il banner."
msgstr "Increméntala cuando cambies la política de cookies. Los visitantes que dieron su consentimiento a una versión anterior volverán a ver el banner."

