msgid "Richiedi consenso cookie"
msgstr "Requerir consentimiento de cookies"

msgid "Blocca gli script di tracking finché l'utente non accetta i cookie analitici/marketing dal banner Cookie Consent. Richiesto per GDPR."
msgstr "Bloquea los scripts de tracking hasta que el usuario acepte las cookies analíticas/de marketing en el banner Cookie Consent. Requerido por el RGPD."

msgid "Anonimizza IP"
msgstr "Anonimizar IP"

msgid "GA4 anonimizza l'IP di default, ma questa opzione aggiunge il parametro esplicito per conformità."
msgstr "GA4 anonimiza la IP por defecto, pero esta opción añade el parámetro explícito para cumplimiento."

msgid "Rispetta Do Not Track"
msgstr "Respetar Do Not Track"

msgid "Non caricare gli script se il browser invia l'header Do Not Track."
msgstr "No cargar los scripts si el navegador envía la cabecera Do Not Track."

msgid "Escludi amministratori"
msgstr "Excluir administradores"

msgid "Non tracciare le visite degli utenti con ruolo Amministratore."
msgstr "No rastrear las visitas de los usuarios con rol Administrador."

msgid "Non configurato"
msgstr "Sin configurar"

msgid "ID"
msgstr "ID"

msgid "Auto-tracking eventi"
msgstr "Auto-tracking de eventos"

msgid "Scegli quali eventi tracciare automaticamente. Vengono inviati a tutti i provider configurati."
msgstr "Elige qué eventos trackear automáticamente. Se envían a todos los proveedores configurados."

msgid "Parametri eventi"
msgstr "Parámetros de eventos"

msgid "Configura i dettagli degli eventi di scroll e download."
msgstr "Configura los detalles de los eventos de scroll y descarga."

msgid "Milestone scroll (%)"
msgstr "Hitos de scroll (%)"

msgid "Percentuali di scroll a cui inviare un evento (separate da virgola)."
msgstr "Porcentajes de scroll en los que enviar un evento (separados por comas)."

msgid "Estensioni download"
msgstr "Extensiones de descarga"

msgid "Estensioni file da tracciare come download (separate da virgola)."
msgstr "Extensiones de archivo a rastrear como descargas (separadas por comas)."

msgid "Privacy e conformità"
msgstr "Privacidad y cumplimiento"

msgid "Opzioni di privacy, GDPR e gestione del consenso."
msgstr "Opciones de privacidad, RGPD y gestión del consentimiento."

msgid "Inserisci script di tracking aggiuntivi. Verranno bloccati dal consenso cookie se abilitato."
msgstr "Inserta scripts de tracking adicionales. Serán bloqueados por el consentimiento de cookies si está activo."

msgid "Script nel <head>"
msgstr "Scripts en <head>"

msgid "Inseriti prima della chiusura di </head>. Utile per snippet di tracking non supportati nativamente."
msgstr "Insertados antes del cierre de </head>. Útil para snippets de tracking no soportados de forma nativa."

