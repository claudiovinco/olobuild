msgid "Rigenerazione in corso..."
msgstr "Regenerating..."

msgid "Svuotare tutta la cache Critical CSS?"
msgstr "Clear the entire Critical CSS cache?"

msgid "Svuotare la cache CSS? I file verranno rigenerati automaticamente."
msgstr "Clear the CSS cache? Files will be regenerated automatically."

msgid "Rigenerato %d su %d pagine (%d errori)"
msgstr "Regenerated %d of %d pages (%d errors)"

msgid "Svuotati %d transient Critical CSS"
msgstr "Cleared %d Critical CSS transients"

msgid "Cache CSS svuotata. I file verranno rigenerati al prossimo caricamento."
msgstr "CSS cache cleared. Files will be regenerated on the next load."

msgid "Salva impostazioni"
msgstr "Save settings"

msgid "Genera automaticamente il CSS above-the-fold e lo inietta inline nel <head>. Il foglio di stile principale viene caricato in modo asincrono."
msgstr "Automatically generates above-the-fold CSS and injects it inline in the <head>. The main stylesheet is loaded asynchronously."

msgid "Abilita Critical CSS"
msgstr "Enable Critical CSS"

msgid "Migliora FCP e LCP inlinando il CSS critico e deferendo il resto."
msgstr "Improves FCP and LCP by inlining critical CSS and deferring the rest."

msgid "Durata cache"
msgstr "Cache duration"

msgid "Il CSS critico viene rigenerato automaticamente alla scadenza. Invalidato quando salvi un template."
msgstr "Critical CSS is automatically regenerated when it expires. Invalidated when you save a template."

msgid "giorni"
msgstr "days"

msgid "Sezioni above-the-fold"
msgstr "Above-the-fold sections"

msgid "Quante sezioni del template analizzare per il CSS critico. 2 è il valore consigliato."
msgstr "How many template sections to analyze for critical CSS. 2 is the recommended value."

msgid "Stato cache"
msgstr "Cache status"

msgid "Stato"
msgstr "Status"

msgid "Pagine in cache"
msgstr "Cached pages"

msgid "Mai"
msgstr "Never"

msgid "Ultima generazione"
msgstr "Last generated"

msgid "Rigenera tutto"
msgstr "Regenerate all"

msgid "Svuota cache"
msgstr "Clear cache"

msgid "Ottimizzazione Asset"
msgstr "Asset Optimization"

msgid "Controlla come vengono caricati JavaScript e CSS nel frontend."
msgstr "Controls how JavaScript and CSS are loaded on the frontend."

msgid "Defer JavaScript"
msgstr "Defer JavaScript"

msgid "Aggiunge l'attributo defer agli script frontend di Olobuild. Non blocca il rendering della pagina."
msgstr "Adds the defer attribute to Olobuild frontend scripts. Does not block page rendering."

msgid "Cache CSS su file"
msgstr "File-based CSS cache"

msgid "Salva il CSS generato dai template come file statici invece di iniettarlo inline. Migliora il caching del browser."
msgstr "Saves CSS generated by templates as static files instead of injecting it inline. Improves browser caching."

msgid "Minifica CSS"
msgstr "Minify CSS"

msgid "Rimuove commenti, spazi e newline dal CSS generato."
msgstr "Removes comments, whitespace and newlines from the generated CSS."

msgid "Cache CSS"
msgstr "CSS cache"

msgid "File in cache"
msgstr "Cached files"

msgid "Dimensione totale"
msgstr "Total size"

msgid "Svuota cache CSS"
msgstr "Clear CSS cache"

msgid "Resource Hints"
msgstr "Resource Hints"

msgid "Suggerimenti al browser per precaricare risorse e velocizzare il caricamento."
msgstr "Hints to the browser to preload resources and speed up loading."

msgid "DNS Prefetch & Preconnect"
msgstr "DNS Prefetch & Preconnect"

msgid "Aggiunge dns-prefetch e preconnect per Google Fonts, YouTube, Vimeo e altri domini esterni."
msgstr "Adds dns-prefetch and preconnect for Google Fonts, YouTube, Vimeo and other external domains."

msgid "Preload font"
msgstr "Preload fonts"

msgid "Precarica i font custom usati come body/heading per evitare FOUT (Flash of Unstyled Text)."
msgstr "Preloads custom fonts used as body/heading to avoid FOUT (Flash of Unstyled Text)."

msgid "Video facade"
msgstr "Video facade"

msgid "Mostra un'anteprima statica dei video YouTube/Vimeo. L'iframe si carica solo al click. Risparmia ~500KB per video."
msgstr "Shows a static preview of YouTube/Vimeo videos. The iframe is loaded only on click. Saves about 500KB per video."

msgid "fetchpriority hero image"
msgstr "fetchpriority hero image"

msgid "Aggiunge fetchpriority=\"high\" alla prima immagine della pagina e rimuove lazy loading dagli elementi above-fold."
msgstr "Adds fetchpriority=\"high\" to the first image on the page and removes lazy loading from above-the-fold elements."

msgid "Lazy loading immagini"
msgstr "Image lazy loading"

msgid "Aggiunge loading=\"lazy\" alle immagini below-the-fold. Riduce il peso iniziale della pagina."
msgstr "Adds loading=\"lazy\" to below-the-fold images. Reduces the initial page weight."

msgid "Domini personalizzati"
msgstr "Custom domains"

msgid "Aggiungi domini per dns-prefetch e preconnect personalizzati (uno per riga, con https://)."
msgstr "Add custom domains for dns-prefetch and preconnect (one per line, including https://)."

msgid "DNS Prefetch"
msgstr "DNS Prefetch"

msgid "Risolve il DNS in anticipo. Utile per CDN e servizi esterni."
msgstr "Resolves DNS in advance. Useful for CDNs and external services."

msgid "Preconnect"
msgstr "Preconnect"

msgid "Apre connessione completa (DNS + TCP + TLS). Più aggressivo del dns-prefetch, usare solo per risorse critiche."
msgstr "Opens a full connection (DNS + TCP + TLS). More aggressive than dns-prefetch — use only for critical resources."

msgid "Pulizia head"
msgstr "Head cleanup"

msgid "Rimuovi risorse non necessarie dal <head> per ridurre richieste e peso della pagina."
msgstr "Remove unnecessary resources from the <head> to reduce requests and page weight."

msgid "Rimuovi jQuery Migrate"
msgstr "Remove jQuery Migrate"

msgid "Rimuove jquery-migrate.js (~10KB). Necessario solo per compatibilità con plugin molto vecchi."
msgstr "Removes jquery-migrate.js (~10 KB). Only needed for compatibility with very old plugins."

msgid "Rimuovi emoji scripts"
msgstr "Remove emoji scripts"

msgid "Rimuove wp-emoji-release.min.js e relativi stili inline. I browser moderni supportano emoji nativamente."
msgstr "Removes wp-emoji-release.min.js and its inline styles. Modern browsers support emoji natively."

msgid "Rimuovi Block CSS"
msgstr "Remove Block CSS"

msgid "Rimuove wp-block-library-css (~30KB). Attiva solo se non usi blocchi Gutenberg nel frontend."
msgstr "Removes wp-block-library-css (~30 KB). Enable only if you don't use Gutenberg blocks on the frontend."

msgid "Rimuovi Classic Theme CSS"
msgstr "Remove Classic Theme CSS"

msgid "Rimuove classic-theme-styles-css. Inutile se non usi un tema classico."
msgstr "Removes classic-theme-styles-css. Useless if you're not using a classic theme."

