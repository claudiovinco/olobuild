{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%"
    },
    "color": {
      "palette": [],
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false
    },
    "typography": {
      "customFontSize": true,
      "fontSizes": [],
      "defaultFontSizes": false
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    },
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false
  },
  "styles": {
    "spacing": {
      "blockGap": "0px",
      "padding": {
        "top": "0px",
        "right": "0px",
        "bottom": "0px",
        "left": "0px"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
