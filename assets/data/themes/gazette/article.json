    { "id": "gza-co-head", "type": "column", "settings": { "width": "1-1" }, "style": {}, "advanced": {}, "children": [
     { "id": "gza-head", "type": "section-header", "settings": {
        "eyebrow_show": true,
        "eyebrow_text": "The Essay · Cities",
        "eyebrow_color": "#9a2b22",
        "eyebrow_separator": "",
        "headline_lines": [
         { "text": "The slow return of the city night market", "color": "#16161a", "italic": false }
        ],
        "headline_font_family": "serif",
