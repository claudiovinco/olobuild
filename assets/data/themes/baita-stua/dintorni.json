d","color":""},"border_radius":0},"advanced":{}}]},{"id":"baita-stua-dintorni-9","type":"column","settings":{"width_medium":"2-5","width_small":"2-5","entrance_animation":"fade-up","entrance_delay":130},"style":{},"advanced":{},"children":[{"id":"baita-stua-dintorni-10","type":"text-block","settings":{"content":"<p>D’inverno la Val di Fassa è neve e silenzio appena fuori dalle piste; d’estate prati, malghe e sentieri fino ai rifugi.</p>","font_size":18,"line_height":1.7,"text_color":"var(--olo-color-text-muted)","tile_padding":{"top":0,"right":0,"bottom":6,"left":0}},"style":{},"advanced":{}}]}]},{"id":"baita-stua-dintorni-11","type":"row","settings":{"layout":"100","stack_mobile":true,"entrance_animation":"fade-up"},"style":{"padding_top":36},"advanced":{},"children":[{"id":"baita-stua-dintorni-12","type":"column","settings":{},"style":{},"advanced":{},"children":[{"id":"baita-stua-dintorni-13","type":"switcher","settings":{"bg":{"type":"none"},"typography_preset":"","items":[{"id":"bs-inverno","title":"Inverno","icon":"snowflake","content":"<p><strong>Ciaspole dalla porta.</strong> L’anello del Pian parte dal prato dietro casa: quattro chilometri nel bosco, due ore con calma. In cantina ci sono sei paia di ciaspole e i bastoncini.</p><p><strong>Piste a quindici minuti.</strong> Gli impianti di Canazei portano al giro dei quattro passi attorno al Sella; al mattino Lorenzo vi porta giù al parcheggio col gatto delle nevi.</p><p><strong>Sci alpinismo.</strong> Le salite con le pelli partono dai passi Pordoi e Sella: per le prime uscite vi presentiamo una guida alpina della valle.</p>","image":"{{OLOBUILD_LIBRARY}}/media/pexels-38891618-ritocco.jpg","link_text":"Le escursioni","link_url":"{{PAGINA:dintorni}}#escursioni"},{"id":"bs-estate","title":"Estate","icon":"sun","content":"<p><strong>Sentieri dalla porta.</strong> In un’ora e mezza si sale ai pascoli sopra il bosco, a 2.100 metri; nelle giornate limpide si vede la Marmolada.</p><p><strong>Laghi e malghe.</strong> Il lago di Carezza è a quaranta minuti d’auto; nelle malghe, aperte da giugno a settembre, si pranza con polenta, formaggio e burro appena fatto.</p><p><strong>In bici.</strong> La ciclabile lungo l’Avisio scende da Canazei verso Moena; in paese si noleggiano le bici a pedalata assistita.</p>","image":"{{OLOBUILD_LIBRARY}}/media/pexels-38908332.jpg","link_text":"Come si arriva","link_url":"{{PAGINA:dintorni}}#come-si-arriva"}],"preset":"custom","nav_style":"tab","animation":"fade","animation_duration":"300","vertical":false,"tab_padding_y":"10","tab_padding_x":"18","tab_font_size":17,"tab_font_weight":"700","tab_gap":4,"tab_radius":999,"container_bg":"color-mix(in srgb, var(--olo-color-primary) 10%, transparent)","container_padding":6,"container_radius":999,"active_bg":"var(--olo-color-light)","active_color":"var(--olo-color-primary)","inactive_color":"var(--olo-color-text-muted)","hover_bg":"","indicator_type":"pill","indicator_color":"","content_bg":"","content_color":"var(--olo-color-text)","content_padding_y":"20","content_padding_x":"0","shadow":"none","shadow_h":"0","shadow_v":"4","shadow_blur":"10","shadow_spread":"0","shadow_color":"rgba(0,0,0,0.15)","shadow_inset":false,"effect_color":"","effect_intensity":"medium","effect_speed":0,"text_effect":"none","text_effect_target":"title","text_effect_speed":"50","text_effect_delay":"0","text_effect_loop":false,"text_effect_cursor":true,"text_effect_cursor_char":"|","text_effect_color":"","text_effect_color_to":"","text_effect_phrases":"","text_effect_pause":"1500","border":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"solid","color":""},"border_hover":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"","color":""},"border_hover_duration":300,"border_effect":"none","border_effect_intensity":"medium","border_effect_color2":"","border_effect_angle":135,"border_effect_speed":4,"wow_disable":false,"wow_backdrop_blur":0,"wow_backdrop_saturate":100,"wow_border_style":"solid","wow_font_family"