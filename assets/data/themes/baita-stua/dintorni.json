ze_mobile":36},"style":{"bg":{"type":"none"},"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0,"border":{"top":0,"right":0,"bottom":0,"left":0,"style":"solid","color":""},"border_radius":0},"advanced":{}}]},{"id":"baita-stua-dintorni-18","type":"column","settings":{"width_medium":"2-5","width_small":"2-5","entrance_animation":"fade-up","entrance_delay":130},"style":{},"advanced":{},"children":[{"id":"baita-stua-dintorni-19","type":"text-block","settings":{"content":"<p>Le nostre preferite, a piedi, con gli sci o in auto. Prima di partire chiedete a Lorenzo: conosce lo stato di ogni sentiero e sa quali malghe sono aperte.</p>","font_size":18,"line_height":1.7,"text_color":"var(--olo-color-text-muted)","tile_padding":{"top":0,"right":0,"bottom":6,"left":0}},"style":{},"advanced":{}}]}]},{"id":"baita-stua-dintorni-20","type":"row","settings":{"layout":"100","stack_mobile":true,"entrance_animation":"fade-up"},"style":{"padding_top":36},"advanced":{},"children":[{"id":"baita-stua-dintorni-21","type":"column","settings":{},"style":{},"advanced":{},"children":[{"id":"baita-stua-dintorni-22","type":"workgrid","settings":{"typography_preset":"","items":[{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-28463999.jpg","title":"Il giro dei quattro passi","meta":"Dicembre – aprile","description":"Con gli sci ai piedi attorno al gruppo del Sella: quattro passi e una quarantina di chilometri fra piste e impianti, in giornata. Si parte da Canazei.","tall":false,"link_url":""},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-28448933.jpg","title":"Il lago di Carezza","meta":"40 minuti in auto","description":"Oltre il Passo di Costalunga, l’acqua verde sotto le guglie del Latemar. Il giro del lago è un chilometro in piano: si fa anche col passeggino.","tall":false,"link_url":""},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-34797482.jpg","title":"I laghetti del bosco","meta":"Fine estate","description":"Specchi d’acqua verde fra i sassi, i larici e i prati dorati di settembre, sotto le pareti del Catinaccio. Si cammina in piano, anche coi bambini.","tall":false,"link_url":""},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-32825890.jpg","title":"Le malghe","meta":"Giugno – settembre","description":"A metà giugno le vacche salgono agli alpeggi: nelle malghe si mangiano polenta, formaggio e burro appena fatto. Lorenzo sa quali sono aperte.","tall":false,"link_url":""},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-18517913.jpg","title":"I larici d’ottobre","meta":"Metà ottobre","description":"Quando i larici diventano d’oro i sentieri si svuotano: è il mese più quieto e il più fotografato. Si cammina fino ai primi di novembre.","tall":false,"link_url":""},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-33412745.jpg","title":"Il cielo di notte","meta":"Notti serene","description":"Senza un lampione intorno, la Via Lattea si vede a occhio nudo. Sulla terrazza ci sono il binocolo e la mappa del cielo d’agosto.","tall":false,"link_url":""}],"columns":3,"items_gap":28,"media_aspect":"4/3","media_tall_aspect":"4/5","media_bg":"var(--olo-color-muted)","media_label_color":"var(--olo-color-text)","hover_zoom":true,"object_position":"center center","title_font_family":"heading","title_color":"var(--olo-color-text)","title_size":26,"title_weight":"500","meta_color":"var(--olo-color-primary)","meta_size":12,"show_desc":true,"desc_color":"var(--olo-color-text-muted)","desc_size":16,"mono_font_family":"sans-serif","card_style":"none","card_radius":{"tl":10,"tr":10,"br":10,"bl":10},"card_bg":"","columns_tablet":2,"columns_mobile":1},"style":{"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0},"advanced":{}}]}]}]},{"id":"baita-stua-dintorni-23","type":"section","settings":{"width":"default","padding":"large","bg":{"type":"solid","color":"var(--olo-color-primary)"},"bg_scope":"section"},"style":{},"advanced":{"html_id":"come-si-arriva"},"children":[{"id":"baita-stua-dintorni-24","type":"row","settings":{"layout":"50-50","stack_mobile":true,"gap":"4