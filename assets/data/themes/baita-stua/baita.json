o al piano terra e uno accanto alle camere: lavabi di pietra, docce grandi e gli accappatoi per la sauna.","tall":false,"link_url":""},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-27972232.jpg","title":"La sauna","meta":"Nel tabià","description":"Finlandese, a legna, per quattro persone: si accende un’ora prima e arriva a 85–90 °C. Fuori c’è la neve per rinfrescarsi.","tall":false,"link_url":"{{PAGINA:baita}}#tabia"},{"image":"{{OLOBUILD_LIBRARY}}/media/pexels-34164516.jpg","title":"Il portico","meta":"Verso ovest","description":"La panca, il tavolo e i gerani di Ester: il sole del pomeriggio fino al tramonto. La terrazza, a sud, guarda il Sassolungo.","tall":false,"link_url":""}],"columns":3,"items_gap":28,"media_aspect":"4/3","media_tall_aspect":"4/5","media_bg":"var(--olo-color-muted)","media_label_color":"var(--olo-color-text)","hover_zoom":true,"object_position":"center center","title_font_family":"heading","title_color":"var(--olo-color-text)","title_size":26,"title_weight":"500","meta_color":"var(--olo-color-primary)","meta_size":12,"show_desc":true,"desc_color":"var(--olo-color-text-muted)","desc_size":16,"mono_font_family":"sans-serif","card_style":"none","card_radius":{"tl":10,"tr":10,"br":10,"bl":10},"card_bg":"","columns_tablet":2,"columns_mobile":1},"style":{"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0},"advanced":{}}]}]}]},{"id":"baita-stua-baita-14","type":"section","settings":{"width":"default","padding":"large","bg":{"type":"solid","color":"var(--olo-color-muted)"},"bg_scope":"section"},"style":{},"advanced":{"html_id":"a-360"},"children":[{"id":"baita-stua-baita-15","type":"row","settings":{"layout":"50-50","stack_mobile":true,"gap":"48","vertical_align":"end"},"style":{},"advanced":{},"children":[{"id":"baita-stua-baita-16","type":"column","settings":{"width_medium":"3-5","width_small":"3-5","entrance_animation":"fade-up"},"style":{},"advanced":{},"children":[{"id":"baita-stua-baita-17","type":"section-header","settings":{"