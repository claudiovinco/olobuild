         "tl_yr_family": "heading",
         "tl_tag_color": "var(--olo-color-primary)",
         "items": [
          { "title": "Arrival & first light", "tag": "Reine", "description": "Meet the group over dinner in a harbour rorbu. Kit check, route briefing, and an easy sunset stroll to shake off the journey. Welcome dinner · rorbu cabin.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "The classic ridge", "tag": "Reinebringen", "description": "A steep stone stairway to one of the north's great viewpoints, then down to a hidden beach for lunch. Afternoon at your own pace. 6 hrs hiking · +440m.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "Paddle to the sands", "tag": "Bunes Bay", "description": "Sea kayak across a still sound to a beach reachable only by water. Wild camp under the cliffs, dinner cooked on the shore. Sea kayak · wild camp.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "Coast path & weather day", "tag": "Moskenes", "description": "A gentler coastal walk between fishing hamlets — and a built-in buffer if the weather wants to reshuffle the week. Flexible day · 4 hrs walking.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "Over the saddle", "tag": "Kvalvika", "description": "Cross a high saddle to the surf beach at Kvalvika, with the option to scramble Ryten for the postcard view down to the sand. 7 hrs hiking · +520m.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "The island village", "tag": "Henningsvær", "description": "A rest day in the \"Venice of Lofoten\" — galleries, a harbour swim for the brave, and the best cinnamon buns on the archipelago. Rest day · guesthouse.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "Final summit", "tag": "Austvågøya", "description": "Our last big day on the trail, finishing with a long descent to the sea and a farewell feast of the day's catch. 8 hrs hiking · farewell dinner.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" },
          { "title": "Departure", "tag": "Svolvær", "description": "A slow morning and transfer to Svolvær for onward flights. Goodbyes, photos, and plans for the next one. Transfer included.", "date": "", "image": "", "video": "", "icon": "", "category": "primary", "icon_color": "" }
         ]
        },
        "style": {},
        "advanced": {},
        "children": []
       }
      ]
