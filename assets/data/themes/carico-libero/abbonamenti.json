font_weight":"","layout":"stack","split_ratio":"1fr 1fr","gap":22,"vertical_align":"end","headline_inline":false,"headline_font_size_tablet":48,"headline_font_size_mobile":37},"style":{"bg":{"type":"none"},"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0,"border":{"top":0,"right":0,"bottom":0,"left":0,"style":"solid","color":""},"border_radius":0},"advanced":{}}]},{"id":"carico-libero-abbonamenti-49","type":"column","settings":{"width_medium":"3-5","width_small":"3-5","entrance_animation":"fade-up","entrance_delay":90},"style":{},"advanced":{},"children":[{"id":"carico-libero-abbonamenti-50","type":"accordion","settings":{"bg":{"type":"none"},"typography_preset":"","panels":[{"id":"cl-a-1","title":"Posso sospendere l’abbonamento?","content":"Sì, quando vuoi e senza spiegare perché: alla reception o con una mail, fino al giorno prima. Il mensile si ferma e riparte quando torni; il trimestrale e l’annuale si allungano dei giorni di sospensione, fino a otto settimane l’anno.","image":"","video":"","icon":""},{"id":"cl-a-2","title":"Serve il certificato medico?","content":"Sì, il certificato per l’attività sportiva non agonistica, valido un anno: lo rilascia il medico di famiglia o un medico dello sport. Per la settimana di prova basta un’autocertificazione.","image":"","video":"","icon":""},{"id":"cl-a-3","title":"Quanto costa un ingresso singolo?","content":"12 €, sala e corsi per tutto il giorno, senza iscrizione. Il carnet da dieci ingressi costa 100 € e si usa in sei mesi, anche in due.","image":"","video":"","icon":""},{"id":"cl-a-4","title":"Ci sono costi di iscrizione?","content":"No. Il primo mese si paga alla prima visita, poi con l’addebito sul conto o sulla carta, il primo di ogni mese.","image":"","video":"","icon":""},{"id":"cl-a-5","title":"Posso cambiare piano?","content":"Sì, dal mese successivo, in tutte e due le direzioni. Se passi a «Tutto compreso», il coach ti chiama per fissare la valutazione.","image":"","video":"","icon":""},{"id":"cl-a-6","title":"Come disdico?","content":"Con una mail o alla reception entro il 20 del mese: dal mese dopo non paghi più. Niente raccomandate e niente penali.","image":"","video":"","icon":""}],"preset":"custom","toggle_mode":false,"default_open":"first","icon_position":"left","icon_style":"arrow","animate_icon":true,"animation_speed":"300","content_transition":"fade","media_align":"right","media_width":"35","media_radius":"8","aspect_ratio":"auto","object_fit":"cover","object_position":"center center","header_bg":"","header_bg_active":"","header_text_color":"var(--olo-color-text)","header_text_color_active":"var(--olo-color-primary)","header_padding_y":"16","header_padding_x":"20","header_font_size":19,"header_font_weight":"700","header_font_family":"var(--olo-font-family)","content_bg":"","content_padding_y":"20","content_padding_x":"20","content_font_size":16,"border_color":"","border_width":"1","text_color":"color-mix(in srgb, var(--olo-color-light) 74%, transparent)","gap":0,"border_radius":0,"faq_schema":true,"separator_style":"border","shadow":"none","backdrop_blur":"0","backdrop_saturate":"100","icon_shape":"none","icon_shape_size":"32","icon_shape_bg":"","icon_color":"var(--olo-color-primary)","border_color_active":"","panel_hover_lift":false,"panel_hover_shadow":"none","effect_color":"","effect_intensity":"medium","effect_speed":0,"text_effect":"none","text_effect_target":"all","text_effect_speed":"50","text_effect_delay":"0","text_effect_loop":false,"text_effect_cursor":true,"text_effect_cursor_char":"|","text_effect_color":"","text_effect_color_to":"","text_effect_phrases":"","text_effect_pause":"1500","border":{"top":0,"right":0,"bottom":1,"left":0,"linked":false,"style":"solid","color":"var(--olo-color-border)"},"border_hover":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"","color":""},"border_hover_duration":300,"border_effect":"none","border_effect_intensity":"medium","border_effect_color2":"","border_effect_angle":135,"bord