"type":"none"},"typography_preset":"","panels":[{"id":"gr-p-1","title":"Cosa devo preparare il giorno dello scatto?","content":"La casa in ordine, le luci accese e le porte interne aperte. Chi abita la casa può restare: a ogni scatto ci spostiamo noi in un’altra stanza, così nessuno finisce nel tour.","image":"","video":"","icon":""},{"id":"gr-p-2","title":"Lavorate anche fuori Firenze?","content":"In tutta la Toscana. Entro 30 km da Firenze il viaggio è compreso; oltre, 0,50 € al km dallo studio, e per i lavori di più giorni anche l’alloggio.","image":"","video":"","icon":""},{"id":"gr-p-3","title":"E se piove?","content":"Gli interni si fotografano con qualsiasi tempo. Il drone no: con la pioggia o col vento oltre i 30 km/h spostiamo il volo, senza costi.","image":"","video":"","icon":""},{"id":"gr-p-4","title":"Come si paga?","content":"Con bonifico: metà alla prenotazione, il resto alla consegna del tour. Le agenzie con l’abbonamento ricevono una fattura sola a fine mese.","image":"","video":"","icon":""},{"id":"gr-p-5","title":"Posso spostare o disdire lo scatto?","content":"Sì, gratis fino al giorno prima. Il giorno stesso tratteniamo 50 € per l’uscita, che scaliamo dallo scatto successivo.","image":"","video":"","icon":""}],"preset":"custom","toggle_mode":false,"default_open":"first","icon_position":"left","icon_style":"arrow","animate_icon":true,"animation_speed":"300","content_transition":"fade","media_align":"right","media_width":"35","media_radius":"8","aspect_ratio":"auto","object_fit":"cover","object_position":"center center","header_bg":"","header_bg_active":"","header_text_color":"var(--olo-color-text)","header_text_color_active":"var(--olo-color-primary)","header_padding_y":"16","header_padding_x":"20","header_font_size":20,"header_font_weight":"600","header_font_family":"var(--olo-font-family-heading)","content_bg":"","content_padding_y":"20","content_padding_x":"20","content_font_size":16,"border_color":"","border_width":"1","text_color":"var(--olo