n San Frediano, col soppalco."},{"id":"museo","titolo":"Museo","immagine":"{{OLOBUILD_LIBRARY}}/media/polyhaven-ballroom-4k.jpg","immagine_leggera":"{{OLOBUILD_LIBRARY}}/media/polyhaven-ballroom-2k.jpg","anteprima":"","yaw":-14,"pitch":5,"descrizione":"Sala delle feste di un palazzo dell’Ottocento, oggi pinacoteca."}],"punti":[{"id":"gr-c1","scena":"casa","yaw":20,"pitch":4,"tipo":"info","destinazione":"","titolo":"Vetrata sul viale","testo":"Quattro metri di vetrata esposta a sud-est, sul viale alberato: il sole entra fino a mezzogiorno, e d’estate le tende di velo bastano.","url":"","icona":""},{"id":"gr-c2","scena":"casa","yaw":7,"pitch":-36,"tipo":"info","destinazione":"","titolo":"Pavimento in rovere sbiancato","testo":"Doghe larghe 18 cm, posate nel 2023: le stesse in tutto l’open space, cucina compresa.","url":"","icona":""},{"id":"gr-c3","scena":"casa","yaw":-18,"pitch":23,"tipo":"info","destinazione":"","titolo":"64 m², soffitto a 3,20 m","testo":"Un solo ambiente di 64 m², alto 3,20 m: c’è spazio per un soppalco da 18 m², già previsto nel progetto.","url":"","icona":""},{"id":"gr-c4","scena":"casa","yaw":151,"pitch":-14,"tipo":"info","destinazione":"","titolo":"Cucina con penisola","testo":"Frigorifero, forno e piano a induzione restano con la casa; la penisola in rovere fa da tavolo per quattro.","url":"","icona":""},{"id":"gr-c5","scena":"casa","yaw":-101,"pitch":7,"tipo":"info","destinazione":"","titolo":"Parete in grassello di calce","testo":"Rasata a mano con tre mani di grassello: l’unica parete lasciata grezza, di proposito.","url":"","icona":""},{"id":"gr-c6","scena":"casa","yaw":-43,"pitch":-36,"tipo":"scena","destinazione":"hotel","titolo":"Prossimo lavoro: l’hotel","testo":"","url":"","icona":""},{"id":"gr-h1","scena":"hotel","yaw":40,"pitch":0,"tipo":"info","destinazione":"","titolo":"Finestra sul giardino","testo":"Dà sul giardino all’italiana e sulle colline: da quando gli ospiti la vedono nel tour, è la camera che chiedono di più.","url":"","icona":""},{"id":"gr-h2","scena":"hotel","yaw":-144,"pitch":-32,"tipo":"info","destinazione":"","titolo":"Due letti, o un matrimoniale","testo":"I due letti singoli si uniscono su richiesta: lo dice la scheda della camera, accanto al tour.","url":"","icona":""},{"id":"gr-h3","scena":"hotel","yaw":-61,"pitch":-13,"tipo":"info","destinazione":"","titolo":"Scrittoio in noce","testo":"Lo scrittoio con la specchiera, le lampade da lettura e il bollitore per il tè: i dettagli che in foto non si notano.","url":"","icona":""},{"id":"gr-h4","scena":"hotel","yaw":122,"pitch":-13,"tipo":"info","destinazione":"","titolo":"Il camino","testo":"Si accende da novembre a marzo. Sulla mensola, le stampe di uccelli della collezione di famiglia.","url":"","icona":""},{"id":"gr-h5","scena":"hotel","yaw":25,"pitch":-32,"tipo":"info","destinazione":"","titolo":"Il salottino","testo":"Due divani a righe davanti alla finestra: la camera misura 32 m², bagno escluso.","url":"","icona":""},{"id":"gr-h6","scena":"hotel","yaw":-113,"pitch":-5,"tipo":"scena","destinazione":"locale","titolo":"Prossimo lavoro: il caffè","testo":"","url":"","icona":""},{"id":"gr-l1","scena":"locale","yaw":18,"pitch":2,"tipo":"info","destinazione":"","titolo":"Le stampe botaniche","testo":"Dodici tavole dell’Ottocento sul mattone a vista: con lo zoom si leggono i nomi delle piante.","url":"","icona":""},{"id":"gr-l2","scena":"locale","yaw":-54,"pitch":9,"tipo":"info","destinazione":"","titolo":"Il soppalco","testo":"Dodici coperti in più sopra la sala, per le cene private fino a dieci persone.","url":"","icona":""},{"id":"gr-l3","scena":"locale","yaw":36,"pitch":31,"tipo":"info","destinazione":"","titolo":"Lampadario a sfera","testo":"In ferro e cristallo, come le lampade a gabbia alle pareti: li ha fatti a mano una bottega di Scandicci.","url":"","icona":""},{"id":"gr-l4","scena":"locale","yaw":-90,"pitch":-23,"tipo":"info","destinazione":"","titolo":"Divanetti in velluto","testo":"La sala d’angolo coi runner verdi si prenota per i gruppi, fino a sedici persone.","url":"","icona":""},{"id":"gr-l5","scena":"locale","yaw":68,"pitch":-5,"tipo":"scena","destinazione":"museo","titolo":"Prossimo lavoro: il museo","testo":"","url":"","icona":""},{"id":"gr-m1","scena":"museo","yaw":-14,"pitch":29,"tipo":"info","destinazione":"","titolo":"Lampadario dorato","testo":"Bronzo dorato e ventiquattro luci: nel tour lo si guarda da vicino, senza la scala del restauratore.","url":"","icona":""},{"id":"gr-m2","scena":"museo","yaw":22,"pitch":-29,"tipo":"info","destinazione":"","titolo":"Parquet intarsiato","testo":"Rovere, noce e acero a disegno di stelle, del 1868: in sala si cammina sulle passatoie, nel tour no.","url":"","icona":""},{"id":"gr-m3","scena":"museo","yaw":-148,"pitch":-25,"tipo":"info","destinazione":"","titolo":"Pianoforte a coda","testo":"Il pianoforte dei concerti della domenica: nella scheda del museo, accanto al tour, c’è il calendario.","url":"","icona":""},{"id":"gr-m4","scena":"museo","yaw":-122,"pitch":18,"tipo":"info","destinazione":"","titolo":"Cariatide in stucco","testo":"Una delle quattro cariatidi della sala, restaurate nel 2019: con lo zoom si vedono i segni della doratura.","url":"","icona":""},{"id":"gr-m5","scena":"museo","yaw":72,"pitch":5,"tipo":"info","destinazione":"","titolo":"Finestre coi tendaggi","testo":"Quattro portefinestre sul giardino, coi tendaggi di seta rifatti al telaio come gli originali.","url":"","icona":""},{"id":"gr-m6","scena":"museo","yaw":-14,"pitch":2,"tipo":"scena","destinazione":"casa","titolo":"Torna al primo lavoro: la casa","testo":"","url":"","icona":""},{"id":"gr-m7","scena":"museo","yaw":162,"pitch":2,"tipo":"link","destinazione":"","titolo":"Un tour così per il tuo spazio","testo":"","url":"{{PAGINA:preventivo}}#prenota","icona":""}],"scena_iniziale":"","fov":75,"zoom":true,"elenco_scene":true,"schermo_intero":true,"autorotazione":true,"velocita":3,"ripresa":6,"mostra_suggerimento":true,"testo_suggerimento":"Trascina per gua