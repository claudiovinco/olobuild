border_hover_duration":300,"border_effect":"none","border_effect_intensity":"medium","border_effect_color2":"","border_effect_angle":135,"border_effect_speed":4,"text_effect":"none","text_effect_target":"caption","text_effect_speed":"50","text_effect_delay":"0","text_effect_loop":false,"text_effect_cursor":true,"text_effect_cursor_char":"|","text_effect_color":"","text_effect_color_to":"","text_effect_phrases":"","text_effect_pause":"1500","shadow_h":0,"shadow_v":24,"shadow_blur":50,"shadow_spread":-20,"shadow_color":"color-mix(in srgb, var(--olo-color-primary) 55%, transparent)"},"style":{},"advanced":{}}]}]}]},{"id":"margini-articolo-17","type":"section","settings":{"width":"default","padding":"large","bg":{"type":"solid","color":"var(--olo-color-background)"},"bg_scope":"section"},"style":{},"advanced":{},"children":[{"id":"margini-articolo-18","type":"row","settings":{"layout":"33-33-33","stack_mobile":true,"gap":"48"},"style":{},"advanced":{},"children":[{"id":"margini-articolo-19","type":"column","settings":{"width_medium":"1-4","width_small":"1-4"},"style":{},"advanced":{},"children":[{"id":"margini-articolo-20","type":"toc","settings":{"bg":{"type":"none"},"typography_preset":"","preset":"custom","title":"In questo articolo","max_depth":"3","list_style":"numbered","text_color":"","link_color":"var(--olo-color-primary)","title_color":"var(--olo-color-text)","font_size":16,"indent":"28","sticky":true,"highlight_active":true,"smooth_scroll":true,"shadow":"none","text_effect":"none","text_effect_target":"title","text_effect_speed":"50","text_effect_delay":"0","text_effect_loop":false,"text_effect_cursor":true,"text_effect_cursor_char":"|","text_effect_color":"","text_effect_color_to":"","text_effect_phrases":"","text_effect_pause":"1500","border":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"solid","color":""},"border_hover":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"","color":""},"border_hover_duration":300,"border_effect":"none","border_effect_intensity":"medium","border_effect_color2":"","border_effect_angle":135,"border_effect_speed":4},"style":{"border":{"top":3,"right":0,"bottom":1,"left":0,"style":"solid","color":"var(--olo-color-text)"},"padding_top":26,"padding_right":8,"padding_bottom":26,"padding_left":8},"advanced":{}}]},{"id":"margini-articolo-21","type":"column","settings":{"width_medium":"1-2","width_small":"1-2"},"style":{},"advanced":{},"children":[{"id":"margini-articolo-22","type":"text-block","settings":{"content":"<p>Il confine, a guardarlo da vicino, non c’è. C’è una strada, due tabaccherie, un distributore che fa lo sconto a chi viene dall’altra parte. Eppure per quarant’anni questa linea ha deciso chi poteva sposarsi con chi, dove si comprava il pane, quale televisione si guardava la sera.</p><h2>La strada</h2><p>Si cammina lungo la vecchia statale. A destra le case hanno i balconi di legno, a sinistra quelli di ferro: è l’unica differenza che si nota, e nessuno sa più spiegarla. Il signor Bruno, ottantadue anni, dice che il ferro l’ha messo suo padre per far vedere che era dall’altra parte.</p><h2>Le tabaccherie</h2><p>Due tabaccherie una di fronte all’altra, a dodici metri. Per trent’anni hanno venduto sigarette diverse a prezzi diversi; oggi vendono le stesse, allo stesso prezzo, ma i clienti non hanno cambiato marciapiede.</p><h2>Quello che resta</h2><p>Un cippo di pietra, mezzo coperto dall’edera, davanti alla fermata dell’autobus. I bambini ci si siedono sopra aspettando la corriera della scuola. Nessuno di loro sa cosa sia, e forse è il modo migliore di ricordarlo.</p>","font_size":20,"text_color":"var(--olo-color-text)"},"style":{},"advanced":{}},{"id":"margini-articolo-23","type":"quotation","settings":{"bg":{"type":"none"},"typography_preset":"","preset":"custom","content":"Un confine è una linea che qualcuno ha deciso di prendere sul serio.","author":"Giulia Rossetti, «La linea che non si vede»","style":"default","alignment":"left","content_font_family":