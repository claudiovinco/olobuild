      "children": [
       { "id": "vy-st-kicker", "type": "headline", "settings": { "heading": "The Long Way · Patagonia", "tag": "div", "alignment": "center", "heading_font": "body", "heading_font_size": "11.5", "heading_uppercase": true, "heading_color": "var(--olo-color-primary)", "decoration": "none" }, "style": {}, "advanced": {}, "children": [] },
       { "id": "vy-st-title", "type": "headline", "settings": { "heading": "The road that goes nowhere, slowly", "tag": "h1", "alignment": "center", "heading_font": "heading", "heading_font_size": "66", "heading_color": "#eef2f7", "decoration": "none" }, "style": {}, "advanced": {}, "children": [] },
       { "id": "vy-st-stand", "type": "text-block", "settings": { "content": "<p>Forty hours of gravel, three flat tyres and one unrepeatable silence — a dispatch from the far end of the Carretera Austral.</p>", "text_color": "#eef2f7", "font_size": "21", "line_height": "1.5", "text_align": "center", "max_width": "720" }, "style": {}, "advanced": {}, "children": [] },
       { "id": "vy-st-byline", "type": "headline", "settings": { "heading": "Mara Quinn · Words & pictures · 16 min", "tag": "div", "alignment": "center", "heading_font": "body", "heading_font_size": "12.5", "heading_uppercase": true, "heading_color": "var(--olo-color-text-muted)", "decoration": "none" }, "style": {}, "advanced": {}, "children": [] }
      ]
     }
    ]
   },
