           "footer_dot_color": "#36d6c3"
          },
          {
           "media_image": "",
           "media_label": "PELLET SELF-SERVE ANALYTICS",
           "title": "Pellet went fully self-serve",
           "description": "<p>Governed models mean PMs and ops answer their own questions — the data team moved from ticket queue to platform work.</p>",
