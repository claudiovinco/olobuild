lign":"end","headline_inline":false},"style":{"bg":{"type":"none"},"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0},"advanced":{}}]}]},{"id":"sorriso-clinic-trattamenti-18","type":"row","settings":{"layout":"100","stack_mobile":true,"entrance_animation":"fade"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-trattamenti-19","type":"column","settings":{},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-trattamenti-20","type":"accordion","settings":{"bg":{"type":"none"},"typography_preset":"","panels":[{"id":"so-1","title":"Fa male?","content":"Quasi mai: usiamo l’anestesia computerizzata, che entra piano e senza il pizzico dell’ago. Per chi ha molta paura c’è la sedazione cosciente con protossido d’azoto: resti sveglio, rilassato, e dopo pochi minuti torni a casa da solo.","image":"","video":"","icon":"heart"},{"id":"so-2","title":"Quando porto mio figlio dal dentista la prima volta?","content":"Per un primo controllo basta la comparsa dei denti da latte. La prima visita ortodontica va fatta entro i 6-7 anni, quando cambiano gli incisivi: è il momento giusto per correggere un palato stretto senza aspettare.","image":"","video":"","icon":"baby"},{"id":"so-3","title":"Quanto dura un impianto, dall’inizio alla fine?","content":"L’intervento dura circa un’ora, in anestesia locale. Poi l’impianto si salda all’osso in tre-quattro mesi e in quel periodo porti un dente provvisorio. Alla fine fissiamo la corona definitiva.","image":"","video":"","icon":"clock"},{"id":"so-4","title":"Gli allineatori trasparenti vanno bene per tutti?","content":"Per la maggior parte degli affollamenti e degli spazi sì; per i casi più complessi può servire l’apparecchio fisso. Lo decidiamo dopo la scansione 3D, che è gratuita.","image":"","video":"","icon":"smile"},{"id":"so-5","title":"Si può pagare a rate?","content":"Sì, fino a 24 mesi senza interessi per i preventivi sopra i 600 €, con una semplice richiesta in studio. Ricevi sempre la fattura per la detrazione del 19%.","image":"","video":"","icon":"credit-card"},{"id":"so-6","title":"Avete le urgenze?","content":"Sì, dal lunedì al sabato: chiama entro le 11 e ti visitiamo in giornata. Fuori orario la segreteria ti dà il numero del medico reperibile.","image":"","video":"","icon":"siren"}],"preset":"custom","toggle_mode":false,"default_open":"first","icon_position":"right","icon_style":"plus","animate_icon":true,"animation_speed":"300","content_transition":"fade","media_align":"right","media_width":38,"media_radius":12,"aspect_ratio":"4/3","object_fit":"cover","object_position":"center center","header_bg":"var(--olo-color-light)","header_bg_active":"color-mix(in srgb, var(--olo-color-primary) 9%, transparent)","header_text_color":"var(--olo-color-text)","header_text_color_active":"var(--olo-color-primary)","header_padding_y":"16","header_padding_x":"20","header_font_size":19,"header_font_weight":"600","header_font_family":"var(--olo-font-family-heading)","content_bg":"var(--olo-color-light)","content_padding_y":"20","content_padding_x":"20","content_font_size":15,"border_color":"color-mix(in srgb, var(--olo-color-primary) 18%, transparent)","border_width":1,"text_color":"var(--olo-color-text-muted)","gap":14,"border_radius":20,"faq_schema":false,"separator_style":"border","shadow":"md","backdrop_blur":"0","backdrop_saturate":"100","icon_shape":"circle","icon_shape_size":34,"icon_shape_bg":"color-mix(in srgb, var(--olo-color-secondary) 18%, transparent)","icon_color":"","border_color_active":"","panel_hover_lift":false,"panel_hover_shadow":"none","effect_color":"","effect_intensity":"medium","effect_speed":0,"text_effect":"none","text_effect_target":"all","text_effect_speed":"50","text_effect_delay":"0","text_effect_loop":false,"text_effect_cursor":true,"text_effect_cursor_char":"|","text_effect_color":"","text_effect_color_to":"","text_effect_phrases":"","text_effect_pause":"1500","border":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"solid","