fault","padding":"default","bg":{"type":"gradient","gradient":{"type":"linear","angle":160,"stops":[{"color":"var(--olo-color-background)","position":0},{"color":"var(--olo-color-muted)","position":100}]}},"bg_scope":"section"},"style":{},"advanced":{"html_id":"trattamenti"},"children":[{"id":"sorriso-clinic-home-w2","type":"row","settings":{"layout":"50-50","stack_mobile":true,"entrance_animation":"slide-up","gap":"48","vertical_align":"end"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w3","type":"column","settings":{"width_medium":"3-5","width_small":"3-5"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w4","type":"section-header","settings":{"typography_preset":"","eyebrow_show":true,"eyebrow_text":"Trattamenti","eyebrow_color":"var(--olo-color-primary)","eyebrow_dot_color":"var(--olo-color-primary)","eyebrow_separator":"· ","headline_lines":[{"text":"Undici specialità,","color":"var(--olo-color-text)","italic":false},{"text":"un solo studio.","color":"var(--olo-color-primary)","italic":false}],"headline_font_family":"serif","headline_font_size":48,"headline_font_size_tablet":39,"headline_font_size_mobile":34,"headline_line_height":1.08,"headline_font_weight":"600","headline_align":"left","tagline_show":false,"tagline_text":"","tagline_text_italic":false,"tagline_text_color":"var(--olo-color-text-muted)","tagline_text_size":18,"layout":"stack","gap":18,"vertical_align":"end","headline_inline":false},"style":{"bg":{"type":"none"},"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0},"advanced":{}}]},{"id":"sorriso-clinic-home-w5","type":"column","settings":{"width_medium":"2-5","width_small":"2-5"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w6","type":"text-block","settings":{"content":"<p>Ogni scheda dice che cosa facciamo, quanto dura e quanto costa. Il preventivo è sempre scritto, prima di cominciare.</p>","text_color":"var(--olo-color-text-muted)","font_size":"17","tile_padding":{"top":0,"right":0,"bottom":12,"left":0}},"style":{},"advanced":{}},{"id":"sorriso-clinic-home-w7","type":"button","settings":{"text":"Tutti i trattamenti e i prezzi","url":"{{PAGINA:trattamenti}}","alignment":"left","border_radius":999,"bg_color":"transparent","text_color":"var(--olo-color-primary)","border":{"top":2,"right":2,"bottom":2,"left":2,"style":"solid","color":"var(--olo-color-primary)"}},"style":{},"advanced":{}}]}]},{"id":"sorriso-clinic-home-w8","type":"row","settings":{"layout":"100","stack_mobile":true,"entrance_animation":"fade"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w9","type":"column","settings":{},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w10","type":"stackscroll","settings":{"top_offset":96,"top_step":22,"card_gap":26,"scale_on_stack":true,"scale_amount":3,"card_min_height":380,"round":28,"card_padding":{"top":44,"right":48,"bottom":44,"left":48},"media_position":"right","object_position":"center center","card_bg_default":"","text_color_default":"","num_color_default":"color-mix(in srgb, currentColor 62%, transparent)","show_number":true,"title_display":true,"shadow":"custom","shadow_h":0,"shadow_v":-14,"shadow_blur":40,"shadow_spread":-18,"shadow_color":"color-mix(in srgb, var(--olo-color-primary) 32%, transparent)","shadow_inset":false,"border":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"solid","color":""},"border_hover":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"","color":""},"border_hover_duration":300,"border_effect":"none","border_effect_intensity":"medium","border_effect_color2":"","border_effect_angle":135,"border_effect_speed":4,"cards":[{"eyebrow":"Da 70 € · 50 minuti","title":"Igiene","accent":"e prevenzione","text":"<p>Detartrasi a ultrasuoni, air-flow per le macchie e lucidatura. L’igienista ti mostra con lo specchietto dove lo spazzolino non arriva e ti richiama dopo sei mesi.</p><ul><li>Sbiancamento alla poltrona da 250 €</li><li>Visita parodontale con la mappa delle gengive</li><li>Sigillature per i bambini da 30 € a dente</li></ul>","media":"{{OLOBUILD_LIBRARY}}/media/pexels-5355834.jpg","color":"var(--olo-color-light)","text_color":"var(--olo-color-text)"},{"eyebrow":"Scansione 3D gratuita","title":"Ortodonzia","accent":"e allineatori","text":"<p>Mascherine trasparenti da cambiare ogni una o due settimane, o l’apparecchio fisso per i casi più complessi. Prima di cominciare vedi in 3D come si sposteranno i denti, mese per mese.</p><ul><li>Allineatori da 2.900 €</li><li>Apparecchio fisso da 2.400 €</li><li>Bite su misura per chi digrigna i denti</li></ul>","media":"{{OLOBUILD_LIBRARY}}/media/pexels-28407749.jpg","color":"var(--olo-color-muted)","text_color":"var(--olo-color-text)"},{"eyebrow":"Da 1.250 € con la corona","title":"Implantologia","accent":"guidata","text":"<p>L’impianto in titanio prende il posto della radice che manca. Lo progettiamo sulla TAC 3D, lo inseriamo in anestesia locale in circa un’ora e, dopo tre-quattro mesi di guarigione, fissiamo la corona definitiva.</p><ul><li>Corona in zirconia-ceramica</li><li>Sedazione cosciente per chi ha paura</li><li>Controlli compresi per il primo anno</li></ul>","media":"{{OLOBUILD_LIBRARY}}/media/pexels-4687905.jpg","color":"var(--olo-color-dark)","text_color":"var(--olo-color-light)"},{"eyebrow":"Faccette da 450 € a dente","title":"Estetica","accent":"del sorriso","text":"<p>Sbiancamento alla poltrona in una seduta di un’ora, faccette in ceramica sottili come una lente a contatto, gengive ricontornate. Prima provi il risultato in resina, sui tuoi denti.</p><ul><li>Prova del sorriso prima di decidere</li><li>Faccette da 0,3 a 0,7 mm</li><li>Colore scelto con la scala, alla luce del giorno</li></ul>","media":"{{OLOBUILD_LIBRARY}}/media/pexels-6627574.jpg","color":"var(--olo-color-light)","text_color":"var(--olo-color-text)"},{"eyebrow":"Otturazioni da 90 €","title":"Conservativa","accent":"ed endodonzia","text":"<p>Otturazioni in composito del colore del dente e devitalizzazioni al microscopio operatorio, spesso in una sola seduta. Con l’anestesia giusta non senti nulla, e te lo diciamo prima.</p><ul><li>Devitalizzazione da 180 €</li><li>Microscopio operatorio per vedere ogni canale</li><li>Ricostruzione nella stessa seduta</li></ul>","media":"{{OLOBUILD_LIBRARY}}/media/pexels-4269944.jpg","color":"var(--olo-color-muted)","text_color":"var(--olo-color-text)"},{"eyebrow":"Prima visita gratis fino a 6 anni","title":"Bambini","accent":"senza paura","text":"<p>Tempi corti, parole semplici e una poltrona che diventa un’astronave. Controlliamo la crescita dei denti e del palato e la prima visita ortodontica la facciamo entro i 6-7 anni, quando cambiano gli incisivi.</p><ul><li>Sigillature dei molari da 30 € a dente</li><li>Fluoroprofilassi a ogni controllo</li><li>Protossido d’azoto per i più timorosi</li></ul>","media":"{{OLOBUILD_LIBRARY}}/media/pexels-7800560.jpg","color":"var(--olo-color-primary)","text_color":"var(--olo-color-light)"}]},"style":{},"advanced":{}}]}]}]},{"id":"sorriso-clinic-home-w11","type":"section","settings":{"width":"default","padding":"default","bg":{"type":"solid","color":"var(--olo-color-light)"},"bg_scope":"section"},"style":{},"advanced":{"html_id":"tecnologia"},"children":[{"id":"sorriso-clinic-home-w12","type":"row","settings":{"layout":"50-50","stack_mobile":true,"entrance_animation":"slide-up","gap":"56","vertical_align":"center"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w13","type":"column","settings":{"width_medium":"1-2","width_small":"1-2"},"style":{},"advanced":{},"children":[{"id":"sorriso-clinic-home-w14","type":"section-header","settings":{"typography_preset":"","eyebrow_show":true,"eyebrow_text":"Tecnologia","eyebrow_color":"var(--olo-color-primary)","eyebrow_dot_color":"var(--olo-color-primary)","eyebrow_separator":"· ","headline_lines":[{"text":"Meno attese,","color":"var(--olo-color-text)","italic":false},{"text":"meno sorprese.","color":"var(--olo-color-prim