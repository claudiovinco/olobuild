        "tl_tag_color": "#ff6a2b",
        "items": [
          { "id": "fg-rel-1", "title": "Remote cache, now content-addressed", "tag": "Feature", "description": "Released 14 May 2026. Rewrote the cache key to fingerprint inputs deterministically — hit rates jumped to 92% across our beta fleet. New forge cache stats command shows hits, misses and bytes saved. Cache is now shared between local dev and CI by default.", "date": "2.4.0", "image": "", "video": "", "icon": "", "category": "success", "icon_color": "" },
          { "id": "fg-rel-2", "title": "Stability & speed", "tag": "Fixes", "description": "Released 2 May 2026. Fixed a race in parallel test sharding that could double-run a suite. Runner cold-start down 40% on the Team plan. The command palette now remembers your last 10 actions.", "date": "2.3.2", "image": "", "video": "", "icon": "", "category": "warning", "icon_color": "" },
          { "id": "fg-rel-3", "title": "Flaky-test detection", "tag": "Feature", "description": "Released 18 Apr 2026. Forge now flags tests that pass and fail on identical inputs, with a quarantine workflow. New insights dashboard charts cycle time and bottlenecks per pipeline. Slack alerts when a flaky test sneaks back in.", "date": "2.3.0", "image": "", "video": "", "icon": "", "category": "success", "icon_color": "" },
          { "id": "fg-rel-4", "title": "Self-hosted runners (Enterprise)", "tag": "Feature", "description": "Released 3 Apr 2026. Bring your own compute — Forge orchestrates, your hardware executes. SSO via SAML and per-project audit logs.", "date": "2.2.0", "image": "", "video": "", "icon": "", "category": "success", "icon_color": "" }
        ]
       }, "style": {}, "advanced": {}, "children": [] }
