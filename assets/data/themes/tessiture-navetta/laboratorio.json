etto domani, su cento metri di pezza."},{"number":"03","title":"La tessitura","description":"Novantasei telai a pinza e ad aria su tre turni: la trama passa seicento volte al minuto, e il telaio si ferma da solo se un filo si rompe."},{"number":"04","title":"Il finissaggio","description":"Lavaggio, tintura in pezza, trattamenti idrorepellenti e termofissaggio: il tessuto prende la sua mano e la sua altezza definitiva."},{"number":"05","title":"Il controllo","description":"Ogni pezza passa sul tavolo luminoso, metro per metro; un campione di ogni lotto va in laboratorio per le quattordici prove."},{"number":"06","title":"La spedizione","description":"Pezze da cento metri avvolte e fasciate, col certificato del lotto. I campionari partono entro 48 ore."}],"columns":3,"gap":16,"auto_number":false,"number_style":"circle","number_color":"var(--olo-color-primary-contrast)","number_bg":"var(--olo-color-primary)","number_size":26,"number_font":"mono","number_weight":"500","title_color":"var(--olo-color-text)","title_size":21,"title_weight":"600","title_font":"heading","desc_color":"var(--olo-color-text-muted)","desc_size":15,"align":"left","item_gap":12,"card_bg":"var(--olo-color-light)","card_border":"","card_radius":{"tl":6,"tr":6,"br":6,"bl":6},"card_padding":26},"style":{"padding_top":0,"padding_right":0,"padding_bottom":0,"padding_left":0},"advanced":{}}]}]}]},{"id":"tessiture-navetta-laboratorio-29","type":"section","settings":{"width":"default","padding":"large","bg":{"type":"solid","color":"var(--olo-color-muted)"},"bg_scope":"section"},"style":{},"advanced":{"html_id":"reparto"},"children":[{"id":"tessiture-navetta-laboratorio-30","type":"row","settings":{"layout":"50-50","stack_mobile":true,"gap":"48","vertical_align":"end"},"style":{},"advanced":{},"children":[{"id":"tessiture-navetta-laboratorio-31","type":"column","settings":{"width_medium":"3-5","width_small":"3-5","entrance_animation":"slide-up"},"style":{},"advanced":{},"children":[{"id":"tessiture-navetta-l