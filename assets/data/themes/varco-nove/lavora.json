ici: la ciclabile arriva fino al varco e dentro ci sono gli spogliatoi con le docce.","image":"","video":"","icon":""},{"id":"vn-l-5","title":"Quanto dura la selezione?","content":"Una telefonata, un colloquio di mezz’ora al varco 9 e, per i carrellisti, una prova pratica. Di solito si comincia entro tre settimane.","image":"","video":"","icon":""}],"preset":"custom","toggle_mode":false,"default_open":"first","icon_position":"left","icon_style":"arrow","animate_icon":true,"animation_speed":"300","content_transition":"fade","media_align":"right","media_width":"35","media_radius":"8","aspect_ratio":"auto","object_fit":"cover","object_position":"center center","header_bg":"","header_bg_active":"","header_text_color":"var(--olo-color-text)","header_text_color_active":"var(--olo-color-primary)","header_padding_y":"16","header_padding_x":"20","header_font_size":19,"header_font_weight":"600","header_font_family":"var(--olo-font-family)","content_bg":"","content_padding_y":"20","content_padding_x":"20","content_font_size":16,"border_color":"","border_width":"1","text_color":"var(--olo-color-text-muted)","gap":0,"border_radius":0,"faq_schema":true,"separator_style":"border","shadow":"none","backdrop_blur":"0","backdrop_saturate":"100","icon_shape":"none","icon_shape_size":"32","icon_shape_bg":"","icon_color":"var(--olo-color-primary)","border_color_active":"","panel_hover_lift":false,"panel_hover_shadow":"none","effect_color":"","effect_intensity":"medium","effect_speed":0,"text_effect":"none","text_effect_target":"all","text_effect_speed":"50","text_effect_delay":"0","text_effect_loop":false,"text_effect_cursor":true,"text_effect_cursor_char":"|","text_effect_color":"","text_effect_color_to":"","text_effect_phrases":"","text_effect_pause":"1500","border":{"top":0,"right":0,"bottom":1,"left":0,"linked":false,"style":"solid","color":"var(--olo-color-border)"},"border_hover":{"top":0,"right":0,"bottom":0,"left":0,"linked":true,"style":"","color":""},"border_hover_duration":300